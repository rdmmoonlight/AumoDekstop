<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="AumoDekstop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ribbon="using:AumoDekstop.Shell.Ribbon"
    xmlns:status="using:AumoDekstop.Shell.Status"
    Title="AumoDekstop">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- 1. RIBBON (tersembunyi sebelum login) -->
        <ribbon:RibbonView
            x:Name="RibbonHost"
            Grid.Row="0"
            Visibility="Collapsed"
            CommandInvoked="OnRibbonCommand"
            TabChanged="OnRibbonTabChanged" />

        <!-- 2. WORKSPACE UTAMA (halaman login atau halaman aplikasi) -->
        <Frame x:Name="RootFrame" Grid.Row="1" Padding="16" />

        <!-- 3. STATUS BAR -->
        <status:StatusBarView x:Name="AppStatusBar" Grid.Row="2" />
    </Grid>
</Window>
