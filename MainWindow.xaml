<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="AumoDekstop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ribbon="using:AumoDekstop.Shell.Ribbon"
    xmlns:status="using:AumoDekstop.Shell.Status"
    Title="AumoDekstop">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- 1. HEADER: TOMBOL MENU UTAMA + RIBBON -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

           <!-- 1. HEADER: RIBBON (tersembunyi sebelum login) -->
           <ribbon:RibbonView
                x:Name="RibbonHost"
                Grid.Row="0"
                CommandInvoked="OnRibbonCommand"
                MenuRequested="OnMenuRequested"
                TabChanged="OnRibbonTabChanged"
                Visibility="Collapsed"/>
        </Grid>

        <!-- 2. WORKSPACE UTAMA + DRAWER MENU UTAMA -->
        <SplitView
            x:Name="MainNavigation"
            Grid.Row="1"
            DisplayMode="Overlay"
            IsPaneOpen="False"
            OpenPaneLength="260">
            <SplitView.Pane>
                <Border
                    Padding="16"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                    <StackPanel Spacing="12">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="Menu Utama"/>
                        <MenuFlyoutSeparator/>
                        <!-- Tambahkan tombol/item menu utama di sini -->
                    </StackPanel>
                </Border>
            </SplitView.Pane>

            <SplitView.Content>
                <Frame x:Name="RootFrame"
                       Padding="16"/>
            </SplitView.Content>
        </SplitView>

        <!-- 3. STATUS BAR -->
        <status:StatusBarView x:Name="AppStatusBar"
                              Grid.Row="2"/>
    </Grid>
</Window>
