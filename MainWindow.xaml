<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="AumoDekstop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AumoDekstop">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- 1. Ribbon: tab menu dan tombol aksi -->
        <StackPanel
            Grid.Row="0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">

            <SelectorBar x:Name="RibbonTabs" SelectionChanged="RibbonTabs_SelectionChanged" Padding="8,4,8,0">
                <SelectorBarItem Text="Beranda" Tag="home" IsSelected="True" />
                <SelectorBarItem Text="Periods" Tag="periods" />
                <SelectorBarItem Text="Data &amp; Transaksi" Tag="data" />
                <SelectorBarItem Text="Laporan" Tag="report" />
                <SelectorBarItem Text="Pengaturan" Tag="settings" />
            </SelectorBar>

            <CommandBar DefaultLabelPosition="Right" HorizontalAlignment="Left" Background="Transparent">
                <AppBarButton Icon="Add" Label="Baru" Click="OnNewClick" />
                <AppBarButton Icon="Save" Label="Simpan" Click="OnSaveClick" />
                <AppBarSeparator />
                <AppBarButton Icon="Refresh" Label="Sinkron API" Click="OnSyncClick" />
                <AppBarButton Icon="Sync" Label="Cek Update" Click="OnCheckUpdateClick" />
            </CommandBar>
        </StackPanel>

        <!-- 2. Workspace utama (diisi lewat kode) -->
        <Frame x:Name="RootFrame" Grid.Row="1" Padding="16" />

        <!-- 3. Status bar bawah -->
        <Grid
            Grid.Row="2"
            Padding="12,0"
            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="StatusText"
                Grid.Column="0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="● Siap" />

            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Mode Hemat RAM" />
        </Grid>
    </Grid>
</Window>
