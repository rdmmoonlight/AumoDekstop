<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================
         GLOBAL TOKENS (Sama untuk Dark & Light)
         ========================================= -->
    <CornerRadius x:Key="AppRadius">12</CornerRadius>       <!-- 0.75rem = 12px -->
    <CornerRadius x:Key="AppInputRadius">6</CornerRadius>   <!-- Untuk input/button kecil -->

    <!-- Charts (hsl dikonversi ke Hex) -->
    <SolidColorBrush x:Key="Chart1Brush" Color="#2463EB"/>  <!-- hsl(221 83% 53%) -->
    <SolidColorBrush x:Key="Chart2Brush" Color="#2A9D8F"/>  <!-- hsl(173 58% 39%) -->
    <SolidColorBrush x:Key="Chart3Brush" Color="#FABB1E"/>  <!-- hsl(43 96% 56%) -->
    <SolidColorBrush x:Key="Chart4Brush" Color="#7C3AED"/>  <!-- hsl(262 83% 58%) -->
    <SolidColorBrush x:Key="Chart5Brush" Color="#F97316"/>  <!-- hsl(24 94% 53%) -->

    <!-- =========================================
         THEME DICTIONARIES (Otomatis switch Dark / Light)
         ========================================= -->
    <ResourceDictionary.ThemeDictionaries>

        <!-- DARK MODE (Key "Default" = standar Dark di WinUI 3) -->
        <ResourceDictionary x:Key="Default">
            <!-- 1. CORE SURFACE -->
            <SolidColorBrush x:Key="BackgroundBrush" Color="#0E0E0E"/>          <!-- hsl(0 0% 5.5%) -->
            <SolidColorBrush x:Key="ForegroundBrush" Color="#F5F5F5"/>          <!-- hsl(0 0% 96%) -->

            <!-- 2. CARD & POPOVER -->
            <SolidColorBrush x:Key="CardBrush" Color="#121212"/>                <!-- hsl(0 0% 7%) -->
            <SolidColorBrush x:Key="CardForegroundBrush" Color="#F5F5F5"/>      <!-- hsl(0 0% 96%) -->
            <SolidColorBrush x:Key="PopoverBrush" Color="#161616"/>             <!-- hsl(0 0% 8.5%) -->
            <SolidColorBrush x:Key="PopoverForegroundBrush" Color="#F5F5F5"/>   <!-- hsl(0 0% 96%) -->

            <!-- 3. ACTION - primary / secondary -->
            <SolidColorBrush x:Key="PrimaryBrush" Color="#FAFAFA"/>             <!-- hsl(0 0% 98%) -->
            <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="#141414"/>   <!-- hsl(0 0% 8%) -->
            <SolidColorBrush x:Key="SecondaryBrush" Color="#1C1C1C"/>           <!-- hsl(0 0% 11%) -->
            <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#EBEBEB"/> <!-- hsl(0 0% 92%) -->

            <!-- 4. MUTED & ACCENT -->
            <SolidColorBrush x:Key="MutedBrush" Color="#1C1C1C"/>               <!-- hsl(0 0% 11%) -->
            <SolidColorBrush x:Key="MutedForegroundBrush" Color="#949494"/>     <!-- hsl(0 0% 58%) -->
            <SolidColorBrush x:Key="AccentBrush" Color="#212121"/>              <!-- hsl(0 0% 13%) -->
            <SolidColorBrush x:Key="AccentForegroundBrush" Color="#F5F5F5"/>    <!-- hsl(0 0% 96%) -->

            <!-- 5. FEEDBACK - destructive -->
            <SolidColorBrush x:Key="DestructiveBrush" Color="#DC2626"/>         <!-- hsl(0 72% 51%) -->
            <SolidColorBrush x:Key="DestructiveForegroundBrush" Color="#FAFAFA"/><!-- hsl(0 0% 98%) -->

            <!-- 6. STRUCTURE - border, input, ring -->
            <SolidColorBrush x:Key="BorderBrush" Color="#242424"/>              <!-- hsl(0 0% 14%) -->
            <SolidColorBrush x:Key="InputBrush" Color="#242424"/>               <!-- hsl(0 0% 14%) -->
            <SolidColorBrush x:Key="RingBrush" Color="#D4D4D4"/>                <!-- hsl(0 0% 83%) -->

            <!-- 8. SIDEBAR -->
            <SolidColorBrush x:Key="SidebarBrush" Color="#0B0B0B"/>             <!-- hsl(0 0% 4.5%) -->
            <SolidColorBrush x:Key="SidebarForegroundBrush" Color="#E0E0E0"/>   <!-- hsl(0 0% 88%) -->
            <SolidColorBrush x:Key="SidebarPrimaryBrush" Color="#FAFAFA"/>      <!-- hsl(0 0% 98%) -->
            <SolidColorBrush x:Key="SidebarPrimaryForegroundBrush" Color="#0F0F0F"/>
            <SolidColorBrush x:Key="SidebarAccentBrush" Color="#1A1A1A"/>       <!-- hsl(0 0% 10%) -->
            <SolidColorBrush x:Key="SidebarAccentForegroundBrush" Color="#F5F5F5"/>
            <SolidColorBrush x:Key="SidebarBorderBrush" Color="#181818"/>       <!-- hsl(0 0% 9.5%) -->
            <SolidColorBrush x:Key="SidebarRingBrush" Color="#D4D4D4"/>
        </ResourceDictionary>

        <!-- LIGHT MODE -->
        <ResourceDictionary x:Key="Light">
            <!-- 1. CORE SURFACE -->
            <SolidColorBrush x:Key="BackgroundBrush" Color="#FFFFFF"/>          <!-- hsl(0 0% 100%) -->
            <SolidColorBrush x:Key="ForegroundBrush" Color="#121212"/>          <!-- hsl(0 0% 7%) -->

            <!-- 2. CARD & POPOVER -->
            <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="CardForegroundBrush" Color="#121212"/>
            <SolidColorBrush x:Key="PopoverBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="PopoverForegroundBrush" Color="#121212"/>

            <!-- 3. ACTION - primary / secondary -->
            <SolidColorBrush x:Key="PrimaryBrush" Color="#171717"/>             <!-- hsl(0 0% 9%) -->
            <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="#FAFAFA"/>   <!-- hsl(0 0% 98%) -->
            <SolidColorBrush x:Key="SecondaryBrush" Color="#F5F5F5"/>           <!-- hsl(0 0% 96%) -->
            <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#171717"/>

            <!-- 4. MUTED & ACCENT -->
            <SolidColorBrush x:Key="MutedBrush" Color="#F5F5F5"/>
            <SolidColorBrush x:Key="MutedForegroundBrush" Color="#737373"/>     <!-- hsl(0 0% 45%) -->
            <SolidColorBrush x:Key="AccentBrush" Color="#F5F5F5"/>
            <SolidColorBrush x:Key="AccentForegroundBrush" Color="#171717"/>

            <!-- 5. FEEDBACK - destructive -->
            <SolidColorBrush x:Key="DestructiveBrush" Color="#EF4444"/>         <!-- hsl(0 84% 60%) -->
            <SolidColorBrush x:Key="DestructiveForegroundBrush" Color="#FAFAFA"/>

            <!-- 6. STRUCTURE - border, input, ring -->
            <SolidColorBrush x:Key="BorderBrush" Color="#E0E0E0"/>              <!-- hsl(0 0% 88%) -->
            <SolidColorBrush x:Key="InputBrush" Color="#E0E0E0"/>
            <SolidColorBrush x:Key="RingBrush" Color="#171717"/>

            <!-- 8. SIDEBAR -->
            <SolidColorBrush x:Key="SidebarBrush" Color="#FBFBFB"/>             <!-- hsl(0 0% 98.5%) -->
            <SolidColorBrush x:Key="SidebarForegroundBrush" Color="#333333"/>   <!-- hsl(0 0% 20%) -->
            <SolidColorBrush x:Key="SidebarPrimaryBrush" Color="#171717"/>
            <SolidColorBrush x:Key="SidebarPrimaryForegroundBrush" Color="#FAFAFA"/>
            <SolidColorBrush x:Key="SidebarAccentBrush" Color="#F4F4F4"/>       <!-- hsl(0 0% 95.5%) -->
            <SolidColorBrush x:Key="SidebarAccentForegroundBrush" Color="#171717"/>
            <SolidColorBrush x:Key="SidebarBorderBrush" Color="#E8E8E8"/>       <!-- hsl(0 0% 91%) -->
            <SolidColorBrush x:Key="SidebarRingBrush" Color="#171717"/>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
