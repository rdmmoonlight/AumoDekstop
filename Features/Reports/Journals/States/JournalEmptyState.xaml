<UserControl
    x:Class="AumoDekstop.Features.Reports.Journals.States.JournalEmptyState"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="8"
        Padding="0,8">

        <!-- Ikon Book (pengganti BookX dari Lucide) -->
        <FontIcon
            Glyph="&#xE82D;"
            FontSize="28"
            HorizontalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

        <!-- Judul: No Entries Found -->
        <TextBlock
            Text="No Entries Found"
            FontSize="14"
            FontWeight="SemiBold"
            HorizontalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

        <!-- Deskripsi: No entries in <selectedPeriodName || 'this period'> -->
        <TextBlock
            FontSize="12"
            HorizontalAlignment="Center"
            TextWrapping="Wrap"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}">
            <Run Text="No entries in "/>
            <Run
                x:Name="PeriodNameRun"
                Text="this period"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
        </TextBlock>
    </StackPanel>
</UserControl>