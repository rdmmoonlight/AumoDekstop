<UserControl
    x:Class="AumoDekstop.Features.Reports.Journals.Controls.ClosingGroupTableControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AumoDekstop.Features.Reports.Journals.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <SolidColorBrush x:Key="AmberRefBrush"
                Color="#F59E0B"/>
        <SolidColorBrush x:Key="EmeraldDebitBrush"
                Color="#10B981"/>
        <SolidColorBrush x:Key="RedCreditBrush"
                Color="#EF4444"/>
    </UserControl.Resources>

    <Border
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">

        <StackPanel>
            <!-- CardHeader -->
            <Border
                Padding="16,12"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
                <TextBlock
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="{x:Bind GroupDescription, Mode=OneWay}"/>
            </Border>

            <!-- Table Header -->
            <Border
                Padding="12,10"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="184"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Padding="24,0,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Ref."/>

                    <TextBlock
                        Grid.Column="1"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Account"/>

                    <TextBlock
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Debit"/>

                    <TextBlock
                        Grid.Column="3"
                        Padding="0,0,24,0"
                        HorizontalAlignment="Right"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Credit"/>
                </Grid>
            </Border>

            <!-- Table Body -->
            <ItemsRepeater ItemsSource="{x:Bind DisplayLines, Mode=OneWay}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:ClosingJournalLineDisplayItem">
                        <Border
                            Padding="12,10"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="184"/>
                                </Grid.ColumnDefinitions>

                                <!-- Ref. Badge -->
                                <Border
                                    Grid.Column="0"
                                    Margin="24,0,0,0"
                                    Padding="8,2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <TextBlock
                                        FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                        FontSize="11"
                                        Foreground="{StaticResource AmberRefBrush}"
                                        Text="{x:Bind FormattedReference}"/>
                                </Border>

                                <!-- Account (Indent & muted jika Credit > 0) -->
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="{x:Bind AccountMargin}"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="{x:Bind AccountFontWeight}"
                                    Foreground="{x:Bind AccountForeground}"
                                    Text="{x:Bind AccountName}"
                                    TextWrapping="Wrap"/>

                                <!-- Debit -->
                                <TextBlock
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                    FontSize="12"
                                    Foreground="{StaticResource EmeraldDebitBrush}"
                                    Text="{x:Bind FormattedDebit}"/>

                                <!-- Credit -->
                                <TextBlock
                                    Grid.Column="3"
                                    Padding="0,0,24,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                    FontSize="12"
                                    Foreground="{StaticResource RedCreditBrush}"
                                    Text="{x:Bind FormattedCredit}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- Table Footer -->
            <Border
                Padding="12,12"
                Background="{ThemeResource SubtleFillColorTertiaryBrush}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="184"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="Bold"
                        Text="Total"/>

                    <TextBlock
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontFamily="Consolas, Cascadia Mono, Segoe UI"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="{StaticResource EmeraldDebitBrush}"
                        Text="{x:Bind FormattedTotalDebit, Mode=OneWay}"/>

                    <TextBlock
                        Grid.Column="3"
                        Padding="0,0,24,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontFamily="Consolas, Cascadia Mono, Segoe UI"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="{StaticResource RedCreditBrush}"
                        Text="{x:Bind FormattedTotalCredit, Mode=OneWay}"/>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>