<UserControl
    x:Class="AumoDekstop.Features.Reports.Journals.GeneralJournalTable"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:AumoDekstop.Features.Reports.Journals"
    mc:Ignorable="d"
    x:Name="RootControl">

    <UserControl.Resources>
        <!-- Template 1: Header Tanggal (v-if="item.showHeader") -->
        <DataTemplate x:Key="DateHeaderTemplate"
                x:DataType="local:FlatJournalRowItem">
            <Border
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,1"
                Padding="16,6">
                <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE787;"
                            FontSize="13"
                            Foreground="#F59E0B"/>
                    <TextBlock
                        Text="{x:Bind FormattedDate}"
                        FontSize="12"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Template 2: Baris Detail Jurnal -->
        <DataTemplate x:Key="JournalLineTemplate"
                x:DataType="local:FlatJournalRowItem">
            <Grid
                MinHeight="40"
                Padding="0,8"
                Background="{x:Bind RowBackground}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="2.4*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>

                <!-- Kolom 1: No. Transaksi + Tooltip Waktu + Tombol Edit/Delete -->
                <Grid Grid.Column="0"
                        Padding="16,0,8,0"
                        Visibility="{x:Bind FirstLineVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="{x:Bind TransactionNumber}"
                        FontFamily="Consolas"
                        FontWeight="Bold"
                        FontSize="12"
                        Foreground="#F59E0B"
                        VerticalAlignment="Center"/>

                    <!-- Tooltip Timestamp (Clock) -->
                    <Button
                        Grid.Column="1"
                        Margin="6,0,0,0"
                        Padding="2"
                        Background="Transparent"
                        BorderThickness="0"
                        VerticalAlignment="Center">
                        <FontIcon
                            Glyph="&#xE823;"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ToolTipService.ToolTip>
                            <ToolTip>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind CreatedAtText}"
                                            FontSize="12"/>
                                    <TextBlock
                                        Text="{x:Bind UpdatedAtText}"
                                        Visibility="{x:Bind UpdatedAtVisibility}"
                                        FontSize="12"/>
                                </StackPanel>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </Button>

                    <!-- Tombol Aksi saat EditMode aktif -->
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="4"
                        Visibility="{Binding EditMode, ElementName=RootControl, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button
                            Width="24"
                            Height="24"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Tag="{x:Bind EntryId}"
                            Click="OnEditClicked"
                            ToolTipService.ToolTip="Edit">
                            <FontIcon Glyph="&#xE70F;"
                                    FontSize="12"/>
                        </Button>
                        <Button
                            Width="24"
                            Height="24"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#EF4444"
                            IsEnabled="{Binding IsNotDeleting, ElementName=RootControl}"
                            Tag="{x:Bind}"
                            Click="OnDeleteClicked"
                            ToolTipService.ToolTip="Hapus">
                            <FontIcon Glyph="&#xE74D;"
                                    FontSize="12"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Kolom 2: Account -->
                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind AccountDisplay}"
                    Margin="{x:Bind AccountMargin}"
                    FontWeight="{x:Bind AccountFontWeight}"
                    Foreground="{x:Bind AccountForeground}"
                    FontSize="12"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center"
                    Padding="0,0,8,0"/>

                <!-- Kolom 3: Description -->
                <TextBlock
                    Grid.Column="2"
                    Text="{x:Bind DescriptionDisplay}"
                    FontSize="12"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center"
                    Padding="0,0,8,0"/>

                <!-- Kolom 4: Ref # (Badge) -->
                <Border
                    Grid.Column="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="6,2">
                    <TextBlock
                        Text="{x:Bind ReferenceDisplay}"
                        FontFamily="Consolas"
                        FontSize="11"
                        Foreground="#F59E0B"/>
                </Border>

                <!-- Kolom 5: Debit -->
                <TextBlock
                    Grid.Column="4"
                    Text="{x:Bind DebitDisplay}"
                    FontFamily="Consolas"
                    FontSize="12"
                    Foreground="#10B981"
                    TextAlignment="Right"
                    VerticalAlignment="Center"
                    Padding="0,0,8,0"/>

                <!-- Kolom 6: Credit -->
                <TextBlock
                    Grid.Column="5"
                    Text="{x:Bind CreditDisplay}"
                    FontFamily="Consolas"
                    FontSize="12"
                    Foreground="#EF4444"
                    TextAlignment="Right"
                    VerticalAlignment="Center"
                    Padding="0,0,16,0"/>
            </Grid>
        </DataTemplate>

        <!-- Selector untuk memilih template baris -->
        <local:JournalRowTemplateSelector
            x:Key="RowTemplateSelector"
            HeaderTemplate="{StaticResource DateHeaderTemplate}"
            LineTemplate="{StaticResource JournalLineTemplate}"/>

        <!-- Style agar item ListView rata penuh tanpa margin bawaan -->
        <Style x:Key="FullWidthListViewItemStyle"
                TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="Padding"
                    Value="0"/>
            <Setter Property="Margin"
                    Value="0"/>
            <Setter Property="MinHeight"
                    Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">
        <!-- Header Tabel -->
        <Border
            Grid.Row="0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Padding="0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="2.4*"/>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                        Text="NO. TRANSAKSI"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Padding="16,0,0,0"/>
                <TextBlock Grid.Column="1"
                        Text="ACCOUNT"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="2"
                        Text="DESCRIPTION"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="3"
                        Text="REF #"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextAlignment="Center"/>
                <TextBlock Grid.Column="4"
                        Text="DEBIT"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextAlignment="Right"
                        Padding="0,0,8,0"/>
                <TextBlock Grid.Column="5"
                        Text="CREDIT"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextAlignment="Right"
                        Padding="0,0,16,0"/>
            </Grid>
        </Border>

        <!-- Body Tabel -->
        <ListView
            Grid.Row="1"
            ItemsSource="{x:Bind FlatData, Mode=OneWay}"
            ItemTemplateSelector="{StaticResource RowTemplateSelector}"
            ItemContainerStyle="{StaticResource FullWidthListViewItemStyle}"
            SelectionMode="None"/>
    </Grid>
</UserControl>