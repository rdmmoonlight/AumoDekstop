<UserControl
    x:Class="AumoDekstop.Features.Reports.TrialBalances.Controls.NoPeriodCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <!-- Pengganti Card border-dashed -->
        <Rectangle
            Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            RadiusX="8"
            RadiusY="8"
            Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
            StrokeDashArray="4 4"
            StrokeThickness="1"/>

        <!-- CardContent (py-16 = 64px vertikal, text-center) -->
        <StackPanel
            Padding="24,64"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">

            <!-- Pengganti EyeOff (size=36) -->
            <FontIcon
                HorizontalAlignment="Center"
                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                FontSize="36"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xED1A;"/>

            <!-- Title -->
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Text="No Period Selected"
                TextAlignment="Center"/>

            <!-- Message -->
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="13"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind EffectiveMessage, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap"/>

            <!-- Pengganti Button + RouterLink to="/periods" -->
            <Button
                Margin="0,4,0,0"
                Padding="12,6"
                HorizontalAlignment="Center"
                Click="GoToPeriodsButton_Click"
                Style="{ThemeResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon
                        VerticalAlignment="Center"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        FontSize="14"
                        Glyph="&#xE787;"/>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="Go to Periods"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>