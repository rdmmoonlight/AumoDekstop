<UserControl
    x:Class="AumoDekstop.Features.Reports.TrialBalances.Controls.TrialBalancesTableControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AumoDekstop.Features.Reports.TrialBalances.Models"
    mc:Ignorable="d">

    <UserControl.Resources>
        <SolidColorBrush x:Key="AmberRefBrush" Color="#F59E0B"/>
        <SolidColorBrush x:Key="EmeraldDebitBrush" Color="#10B981"/>
        <SolidColorBrush x:Key="RedCreditBrush" Color="#EF4444"/>
    </UserControl.Resources>

    <Border
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">

        <StackPanel>
            <!-- Table Header -->
            <Border
                Padding="12,10"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10*"/>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="15*"/>
                        <ColumnDefinition Width="12*"/>
                        <ColumnDefinition Width="13*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Padding="12,0,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Ref."/>

                    <TextBlock
                        Grid.Column="1"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Account"/>

                    <TextBlock
                        Grid.Column="2"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Type"/>

                    <TextBlock
                        Grid.Column="3"
                        HorizontalAlignment="Right"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Debit"/>

                    <TextBlock
                        Grid.Column="4"
                        Padding="0,0,12,0"
                        HorizontalAlignment="Right"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Credit"/>
                </Grid>
            </Border>

            <!-- Table Body (Jika ada data) -->
            <ItemsRepeater
                ItemsSource="{x:Bind DisplayRows, Mode=OneWay}"
                Visibility="{x:Bind HasRows, Mode=OneWay}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:TrialRow">
                        <Border
                            Padding="12,10"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="10*"/>
                                    <ColumnDefinition Width="50*"/>
                                    <ColumnDefinition Width="15*"/>
                                    <ColumnDefinition Width="12*"/>
                                    <ColumnDefinition Width="13*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Ref. Badge (outline, amber-500) -->
                                <Border
                                    Grid.Column="0"
                                    Margin="12,0,0,0"
                                    Padding="8,2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <TextBlock
                                        FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                        FontSize="11"
                                        Foreground="{StaticResource AmberRefBrush}"
                                        Text="{x:Bind FormattedReferenceNumber}"/>
                                </Border>

                                <!-- Account -->
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Text="{x:Bind AccountName}"
                                    TextWrapping="Wrap"/>

                                <!-- Type Badge (secondary) -->
                                <Border
                                    Grid.Column="2"
                                    Padding="8,2"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="6">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Type}"/>
                                </Border>

                                <!-- Debit -->
                                <TextBlock
                                    Grid.Column="3"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                    FontSize="12"
                                    Foreground="{StaticResource EmeraldDebitBrush}"
                                    Text="{x:Bind FormattedDebit}"/>

                                <!-- Credit -->
                                <TextBlock
                                    Grid.Column="4"
                                    Padding="0,0,12,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                    FontSize="12"
                                    Foreground="{StaticResource RedCreditBrush}"
                                    Text="{x:Bind FormattedCredit}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!-- Empty State (Pengganti v-else: No accounts found.) -->
            <Border
                Padding="12,32"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Visibility="{x:Bind IsEmpty, Mode=OneWay}">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="No accounts found."/>
            </Border>

            <!-- Table Footer -->
            <Border
                Padding="12,12"
                Background="{ThemeResource SubtleFillColorTertiaryBrush}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10*"/>
                        <ColumnDefinition Width="50*"/>
                        <ColumnDefinition Width="15*"/>
                        <ColumnDefinition Width="12*"/>
                        <ColumnDefinition Width="13*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Padding="12,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Text="Total"/>

                    <TextBlock
                        Grid.Column="3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontFamily="Consolas, Cascadia Mono, Segoe UI"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{StaticResource EmeraldDebitBrush}"
                        Text="{x:Bind FormattedTotalDebit, Mode=OneWay}"/>

                    <TextBlock
                        Grid.Column="4"
                        Padding="0,0,12,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontFamily="Consolas, Cascadia Mono, Segoe UI"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{StaticResource RedCreditBrush}"
                        Text="{x:Bind FormattedTotalCredit, Mode=OneWay}"/>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>