<Page
    x:Class="AumoDekstop.Features.Reports.TrialBalances.Views.PostClosingTrialBalancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AumoDekstop.Features.Reports.TrialBalances.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="EmeraldHeaderBrush" Color="#10B981"/>
        <!-- bg-amber-500/10 (#1AF59E0B) & border-amber-500/20 (#33F59E0B) -->
        <SolidColorBrush x:Key="AmberAlertBackgroundBrush" Color="#1AF59E0B"/>
        <SolidColorBrush x:Key="AmberAlertBorderBrush" Color="#33F59E0B"/>
        <SolidColorBrush x:Key="AmberIconBrush" Color="#F59E0B"/>
    </Page.Resources>

    <ScrollViewer>
        <Grid Padding="24">
            <!-- Loading State -->
            <StackPanel
                Padding="0,64"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
                <ProgressRing
                    Width="16"
                    Height="16"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Loading post-closing..."/>
            </StackPanel>

            <!-- Main Content -->
            <StackPanel
                Spacing="24"
                Visibility="{x:Bind ViewModel.IsContentVisible, Mode=OneWay}">

                <!-- Page Header -->
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="22"
                            Foreground="{StaticResource EmeraldHeaderBrush}"
                            Glyph="&#xEA18;"/>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Text="Post-Closing Trial Balance"/>
                    </StackPanel>

                    <TextBlock
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="After closing entries • Only permanent accounts • IDR"/>
                </StackPanel>

                <!-- Not Closed Warning Alert (bg-amber-500/10) -->
                <Border
                    Padding="16,12"
                    Background="{StaticResource AmberAlertBackgroundBrush}"
                    BorderBrush="{StaticResource AmberAlertBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.NotClosed, Mode=OneWay}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Info Icon (size=16) -->
                        <FontIcon
                            Grid.Column="0"
                            Margin="0,2,0,0"
                            VerticalAlignment="Top"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Foreground="{StaticResource AmberIconBrush}"
                            Glyph="&#xE946;"/>

                        <StackPanel Grid.Column="1" Spacing="12">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="{x:Bind ViewModel.NotClosedMessage, Mode=OneWay}"
                                TextWrapping="Wrap"/>

                            <Button
                                Padding="12,6"
                                HorizontalAlignment="Left"
                                Click="NavigateToPeriodsButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        FontSize="14"
                                        Glyph="&#xE72A;"/>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="Ke halaman Periods"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Error Alert (variant="destructive") -->
                <InfoBar
                    Title="Error"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.ShowErrorAlert, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error"
                    Visibility="{x:Bind ViewModel.ShowErrorAlert, Mode=OneWay}"/>

                <!-- No Period Selected Card -->
                <controls:NoPeriodCardControl
                    Message="Select a period to view post-closing balance."
                    NavigateToPeriodsClicked="NavigateToPeriodsButton_Click"
                    Visibility="{x:Bind ViewModel.NoPeriod, Mode=OneWay}"/>

                <!-- Report Table & Balance Alert -->
                <StackPanel
                    Spacing="24"
                    Visibility="{x:Bind ViewModel.ShowReportContent, Mode=OneWay}">

                    <controls:TrialBalancesTableControl
                        Rows="{x:Bind ViewModel.Rows, Mode=OneWay}"
                        TotalCredit="{x:Bind ViewModel.TotalCredit, Mode=OneWay}"
                        TotalDebit="{x:Bind ViewModel.TotalDebit, Mode=OneWay}"/>

                    <controls:BalanceAlertControl
                        BalancedText="Post-closing TB is balanced - ready for next period"
                        IsBalanced="{x:Bind ViewModel.IsBalanced, Mode=OneWay}"
                        UnbalancedText="Out of balance - check closing entries"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>