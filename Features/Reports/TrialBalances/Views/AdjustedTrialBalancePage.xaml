<Page
    x:Class="AumoDekstop.Features.Reports.TrialBalances.Views.AdjustedTrialBalancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AumoDekstop.Features.Reports.TrialBalances.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="AmberHeaderBrush" Color="#F59E0B"/>
    </Page.Resources>

    <ScrollViewer>
        <Grid Padding="24">
            <!-- Loading State -->
            <StackPanel
                Padding="0,64"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
                <ProgressRing
                    Width="16"
                    Height="16"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Loading adjusted trial balance..."/>
            </StackPanel>

            <!-- Main Content -->
            <StackPanel
                Spacing="24"
                Visibility="{x:Bind ViewModel.IsContentVisible, Mode=OneWay}">

                <!-- Page Header -->
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="22"
                            Foreground="{StaticResource AmberHeaderBrush}"
                            Glyph="&#xE762;"/>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Text="Adjusted Trial Balance"/>
                    </StackPanel>

                    <TextBlock
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="After adjusting entries • IDR"/>
                </StackPanel>

                <!-- Error Alert (variant="destructive") -->
                <InfoBar
                    Title="Error"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.ShowErrorAlert, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error"
                    Visibility="{x:Bind ViewModel.ShowErrorAlert, Mode=OneWay}"/>

                <!-- No Period Selected Card -->
                <controls:NoPeriodCardControl
                    NavigateToPeriodsClicked="NoPeriodCard_NavigateToPeriodsClicked"
                    Visibility="{x:Bind ViewModel.NoPeriod, Mode=OneWay}"/>

                <!-- Report Table & Balance Alert -->
                <StackPanel
                    Spacing="24"
                    Visibility="{x:Bind ViewModel.ShowReportContent, Mode=OneWay}">

                    <controls:TrialBalancesTableControl
                        Rows="{x:Bind ViewModel.Rows, Mode=OneWay}"
                        TotalCredit="{x:Bind ViewModel.TotalCredit, Mode=OneWay}"
                        TotalDebit="{x:Bind ViewModel.TotalDebit, Mode=OneWay}"/>

                    <controls:BalanceAlertControl
                        BalancedText="Adjusted TB is balanced"
                        IsBalanced="{x:Bind ViewModel.IsBalanced, Mode=OneWay}"
                        UnbalancedText="Unbalanced - check adjusting entries"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>