<Page
    x:Class="AumoDekstop.Features.Reports.Worksheet.WorksheetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AumoDekstop.Features.Reports.Worksheet"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24">
            <!-- ================= LOADING STATE ================= -->
            <StackPanel
                Padding="0,64"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10"
                Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}">
                <ProgressRing
                    Width="18"
                    Height="18"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Loading Worksheet..."/>
            </StackPanel>

            <!-- ================= MAIN CONTENT ================= -->
            <StackPanel Spacing="24"
                        Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">

                <!-- Error Alert -->
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    Severity="Error"/>

                <!-- Empty / No Period Selected Card -->
                <Border
                    Padding="24,64"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.NoPeriodVisibility, Mode=OneWay}">
                    <StackPanel HorizontalAlignment="Center"
                                Spacing="12">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="36"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xED1A;"/>
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="No Period Selected"/>
                        <Button
                            HorizontalAlignment="Center"
                            Click="OnGoToPeriodsClick"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6">
                                <FontIcon FontSize="14"
                                          Glyph="&#xE787;"/>
                                <TextBlock Text="Go to Periods"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Worksheet Data Section -->
                <StackPanel Spacing="24"
                            Visibility="{x:Bind ViewModel.WorksheetContentVisibility, Mode=OneWay}">

                    <!-- Header Title & Action Button -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Spacing="4">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8">
                                <FontIcon
                                    FontSize="22"
                                    Foreground="#0EA5E9"
                                    Glyph="&#xF0E2;"/>
                                <TextBlock
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Text="10-Column Worksheet"/>
                            </StackPanel>
                            <TextBlock
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Trial Balance → Adjustments → Adjusted TB → Income Statement → Balance Sheet • IDR"
                                TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Click="OnGoToIncomeStatementClick">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6">
                                <FontIcon FontSize="14"
                                          Glyph="&#xE9D2;"/>
                                <TextBlock Text="Income Statement"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Komponen Tabel 10 Kolom -->
                    <local:WorksheetTable
                        x:Name="WorksheetTableControl"
                        NetIncome="{x:Bind ViewModel.NetIncome, Mode=OneWay}"
                        Totals="{x:Bind ViewModel.Totals, Mode=OneWay}"/>

                    <!-- Info Alert Net Income -->
                    <InfoBar
                        IsClosable="False"
                        IsOpen="True"
                        Severity="Informational">
                        <InfoBar.Content>
                            <TextBlock
                                Padding="0,0,12,12"
                                FontSize="13"
                                TextWrapping="Wrap">
                                <Run Text="Net Income: "/>
                                <Run FontWeight="Bold"
                                     Text="{x:Bind ViewModel.NetIncomeDisplay, Mode=OneWay}"/>
                                <Run Text=" — plugged from Income Statement to Balance Sheet."/>
                            </TextBlock>
                        </InfoBar.Content>
                    </InfoBar>

                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>