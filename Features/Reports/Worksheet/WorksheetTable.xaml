<UserControl
    x:Class="AumoDekstop.Features.Reports.Worksheet.WorksheetTable"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AumoDekstop.Features.Reports.Worksheet"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Warna aksen sesuai tema Tailwind pada komponen Vue -->
        <SolidColorBrush x:Key="AmberTextBrush"
                         Color="#F59E0B"/>
        <SolidColorBrush x:Key="EmeraldTextBrush"
                         Color="#10B981"/>
        <SolidColorBrush x:Key="SkyTextBrush"
                         Color="#0EA5E9"/>
        <SolidColorBrush x:Key="PrimaryTintBrush"
                         Color="#0D3B82F6"/>

        <!-- Style umum sel angka monospace rata kanan -->
        <Style x:Key="NumericCellStyle"
               TargetType="TextBlock">
            <Setter Property="FontFamily"
                    Value="Cascadia Code, Consolas, Monospace"/>
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="HorizontalAlignment"
                    Value="Right"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            <Setter Property="Padding"
                    Value="8,6"/>
        </Style>

        <!-- Style header kolom -->
        <Style x:Key="HeaderTextStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            <Setter Property="Padding"
                    Value="8,6"/>
        </Style>

        <!-- Style teks footer bold -->
        <Style x:Key="FooterNumericStyle"
               BasedOn="{StaticResource NumericCellStyle}"
               TargetType="TextBlock">
            <Setter Property="FontWeight"
                    Value="Bold"/>
        </Style>
    </UserControl.Resources>

    <Border
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">

        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Grid MinWidth="1280">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ================= HEADER (2 TINGKAT) ================= -->
                <Border
                    Grid.Row="0"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="102"/>
                            <ColumnDefinition Width="102"/>
                            <ColumnDefinition Width="102"/>
                            <ColumnDefinition Width="102"/>
                            <ColumnDefinition Width="102"/>
                            <ColumnDefinition Width="102"/>
                            <ColumnDefinition Width="102"/>
                            <ColumnDefinition Width="102"/>
                            <ColumnDefinition Width="102"/>
                            <ColumnDefinition Width="102"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Account (RowSpan 2) -->
                        <TextBlock
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="0"
                            Style="{StaticResource HeaderTextStyle}"
                            Text="Account"/>

                        <!-- Group Headers (ColSpan 2 + Border Kiri) -->
                        <Border Grid.Row="0"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1,0,0,1">
                            <TextBlock HorizontalAlignment="Center"
                                       Style="{StaticResource HeaderTextStyle}"
                                       Text="Trial Balance"/>
                        </Border>
                        <Border Grid.Row="0"
                                Grid.Column="3"
                                Grid.ColumnSpan="2"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1,0,0,1">
                            <TextBlock HorizontalAlignment="Center"
                                       Style="{StaticResource HeaderTextStyle}"
                                       Text="Adjustments"/>
                        </Border>
                        <Border Grid.Row="0"
                                Grid.Column="5"
                                Grid.ColumnSpan="2"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1,0,0,1">
                            <TextBlock HorizontalAlignment="Center"
                                       Style="{StaticResource HeaderTextStyle}"
                                       Text="Adjusted TB"/>
                        </Border>
                        <Border Grid.Row="0"
                                Grid.Column="7"
                                Grid.ColumnSpan="2"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1,0,0,1">
                            <TextBlock HorizontalAlignment="Center"
                                       Style="{StaticResource HeaderTextStyle}"
                                       Text="Income Statement"/>
                        </Border>
                        <Border Grid.Row="0"
                                Grid.Column="9"
                                Grid.ColumnSpan="2"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1,0,0,1">
                            <TextBlock HorizontalAlignment="Center"
                                       Style="{StaticResource HeaderTextStyle}"
                                       Text="Balance Sheet"/>
                        </Border>

                        <!-- Sub Headers Dr / Cr -->
                        <Border Grid.Row="1"
                                Grid.Column="1"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1,0,0,0">
                            <TextBlock HorizontalAlignment="Right"
                                       Style="{StaticResource HeaderTextStyle}"
                                       Text="Dr"/>
                        </Border>
                        <TextBlock Grid.Row="1"
                                   Grid.Column="2"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource HeaderTextStyle}"
                                   Text="Cr"/>

                        <Border Grid.Row="1"
                                Grid.Column="3"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1,0,0,0">
                            <TextBlock HorizontalAlignment="Right"
                                       Style="{StaticResource HeaderTextStyle}"
                                       Text="Dr"/>
                        </Border>
                        <TextBlock Grid.Row="1"
                                   Grid.Column="4"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource HeaderTextStyle}"
                                   Text="Cr"/>

                        <Border Grid.Row="1"
                                Grid.Column="5"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1,0,0,0">
                            <TextBlock HorizontalAlignment="Right"
                                       Style="{StaticResource HeaderTextStyle}"
                                       Text="Dr"/>
                        </Border>
                        <TextBlock Grid.Row="1"
                                   Grid.Column="6"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource HeaderTextStyle}"
                                   Text="Cr"/>

                        <Border Grid.Row="1"
                                Grid.Column="7"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1,0,0,0">
                            <TextBlock HorizontalAlignment="Right"
                                       Style="{StaticResource HeaderTextStyle}"
                                       Text="Dr"/>
                        </Border>
                        <TextBlock Grid.Row="1"
                                   Grid.Column="8"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource HeaderTextStyle}"
                                   Text="Cr"/>

                        <Border Grid.Row="1"
                                Grid.Column="9"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1,0,0,0">
                            <TextBlock HorizontalAlignment="Right"
                                       Style="{StaticResource HeaderTextStyle}"
                                       Text="Dr"/>
                        </Border>
                        <TextBlock Grid.Row="1"
                                   Grid.Column="10"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource HeaderTextStyle}"
                                   Text="Cr"/>
                    </Grid>
                </Border>

                <!-- ================= BODY (ITEMS REPEATER) ================= -->
                <ItemsRepeater Grid.Row="1"
                               ItemsSource="{x:Bind Rows, Mode=OneWay}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="local:WorksheetRow">
                            <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="102"/>
                                        <ColumnDefinition Width="102"/>
                                        <ColumnDefinition Width="102"/>
                                        <ColumnDefinition Width="102"/>
                                        <ColumnDefinition Width="102"/>
                                        <ColumnDefinition Width="102"/>
                                        <ColumnDefinition Width="102"/>
                                        <ColumnDefinition Width="102"/>
                                        <ColumnDefinition Width="102"/>
                                        <ColumnDefinition Width="102"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Account Badge + Name -->
                                    <StackPanel
                                        Grid.Column="0"
                                        Padding="8,6"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <Border
                                            Padding="6,2"
                                            VerticalAlignment="Center"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                            <TextBlock
                                                FontFamily="Cascadia Code, Consolas, Monospace"
                                                FontSize="11"
                                                Text="{x:Bind ReferenceNumber}"/>
                                        </Border>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Text="{x:Bind AccountName}"
                                            TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Trial Balance -->
                                    <Border Grid.Column="1"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="1,0,0,0">
                                        <TextBlock Style="{StaticResource NumericCellStyle}"
                                                   Text="{x:Bind UnadjustedDebitDisplay}"/>
                                    </Border>
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource NumericCellStyle}"
                                               Text="{x:Bind UnadjustedCreditDisplay}"/>

                                    <!-- Adjustments (Amber) -->
                                    <Border Grid.Column="3"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="1,0,0,0">
                                        <TextBlock Foreground="{StaticResource AmberTextBrush}"
                                                   Style="{StaticResource NumericCellStyle}"
                                                   Text="{x:Bind AdjustmentDebitDisplay}"/>
                                    </Border>
                                    <TextBlock Grid.Column="4"
                                               Foreground="{StaticResource AmberTextBrush}"
                                               Style="{StaticResource NumericCellStyle}"
                                               Text="{x:Bind AdjustmentCreditDisplay}"/>

                                    <!-- Adjusted TB -->
                                    <Border Grid.Column="5"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="1,0,0,0">
                                        <TextBlock Style="{StaticResource NumericCellStyle}"
                                                   Text="{x:Bind AdjustedDebitDisplay}"/>
                                    </Border>
                                    <TextBlock Grid.Column="6"
                                               Style="{StaticResource NumericCellStyle}"
                                               Text="{x:Bind AdjustedCreditDisplay}"/>

                                    <!-- Income Statement (Emerald) -->
                                    <Border Grid.Column="7"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="1,0,0,0">
                                        <TextBlock Foreground="{StaticResource EmeraldTextBrush}"
                                                   Style="{StaticResource NumericCellStyle}"
                                                   Text="{x:Bind IncomeStatementDebitDisplay}"/>
                                    </Border>
                                    <TextBlock Grid.Column="8"
                                               Foreground="{StaticResource EmeraldTextBrush}"
                                               Style="{StaticResource NumericCellStyle}"
                                               Text="{x:Bind IncomeStatementCreditDisplay}"/>

                                    <!-- Balance Sheet (Sky) -->
                                    <Border Grid.Column="9"
                                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            BorderThickness="1,0,0,0">
                                        <TextBlock Foreground="{StaticResource SkyTextBrush}"
                                                   Style="{StaticResource NumericCellStyle}"
                                                   Text="{x:Bind FinancialPositionDebitDisplay}"/>
                                    </Border>
                                    <TextBlock Grid.Column="10"
                                               Foreground="{StaticResource SkyTextBrush}"
                                               Style="{StaticResource NumericCellStyle}"
                                               Text="{x:Bind FinancialPositionCreditDisplay}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- ================= EMPTY STATE ================= -->
                <Border
                    Grid.Row="1"
                    Height="96"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    Visibility="{x:Bind EmptyStateVisibility, Mode=OneWay}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="No worksheet rows."/>
                </Border>

                <!-- ================= FOOTER (3 BARIS) ================= -->
                <StackPanel Grid.Row="2"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <!-- Baris 1: Total -->
                    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="102"/>
                                <ColumnDefinition Width="102"/>
                                <ColumnDefinition Width="102"/>
                                <ColumnDefinition Width="102"/>
                                <ColumnDefinition Width="102"/>
                                <ColumnDefinition Width="102"/>
                                <ColumnDefinition Width="102"/>
                                <ColumnDefinition Width="102"/>
                                <ColumnDefinition Width="102"/>
                                <ColumnDefinition Width="102"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Padding="8,6"
                                HorizontalAlignment="Right"
                                FontSize="12"
                                FontWeight="Bold"
                                Text="Total"/>

                            <Border Grid.Column="1"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="1,0,0,0">
                                <TextBlock Style="{StaticResource FooterNumericStyle}"
                                           Text="{x:Bind Totals.UnadjustedDebitDisplay, Mode=OneWay}"/>
                            </Border>
                            <TextBlock Grid.Column="2"
                                       Style="{StaticResource FooterNumericStyle}"
                                       Text="{x:Bind Totals.UnadjustedCreditDisplay, Mode=OneWay}"/>

                            <Border Grid.Column="3"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="1,0,0,0">
                                <TextBlock Foreground="{StaticResource AmberTextBrush}"
                                           Style="{StaticResource FooterNumericStyle}"
                                           Text="{x:Bind Totals.AdjustmentDebitDisplay, Mode=OneWay}"/>
                            </Border>
                            <TextBlock Grid.Column="4"
                                       Foreground="{StaticResource AmberTextBrush}"
                                       Style="{StaticResource FooterNumericStyle}"
                                       Text="{x:Bind Totals.AdjustmentCreditDisplay, Mode=OneWay}"/>

                            <Border Grid.Column="5"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="1,0,0,0">
                                <TextBlock Style="{StaticResource FooterNumericStyle}"
                                           Text="{x:Bind Totals.AdjustedDebitDisplay, Mode=OneWay}"/>
                            </Border>
                            <TextBlock Grid.Column="6"
                                       Style="{StaticResource FooterNumericStyle}"
                                       Text="{x:Bind Totals.AdjustedCreditDisplay, Mode=OneWay}"/>

                            <Border Grid.Column="7"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="1,0,0,0">
                                <TextBlock Foreground="{StaticResource EmeraldTextBrush}"
                                           Style="{StaticResource FooterNumericStyle}"
                                           Text="{x:Bind Totals.IsDebitDisplay, Mode=OneWay}"/>
                            </Border>
                            <TextBlock Grid.Column="8"
                                       Foreground="{StaticResource EmeraldTextBrush}"
                                       Style="{StaticResource FooterNumericStyle}"
                                       Text="{x:Bind Totals.IsCreditDisplay, Mode=OneWay}"/>

                            <Border Grid.Column="9"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="1,0,0,0">
                                <TextBlock Foreground="{StaticResource SkyTextBrush}"
                                           Style="{StaticResource FooterNumericStyle}"
                                           Text="{x:Bind Totals.BsDebitDisplay, Mode=OneWay}"/>
                            </Border>
                            <TextBlock Grid.Column="10"
                                       Foreground="{StaticResource SkyTextBrush}"
                                       Style="{StaticResource FooterNumericStyle}"
                                       Text="{x:Bind Totals.BsCreditDisplay, Mode=OneWay}"/>
                        </Grid>
                    </Border>

                    <!-- Baris 2: Net Income (plug) -->
                    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="872"/>
                                <ColumnDefinition Width="102"/>
                                <ColumnDefinition Width="102"/>
                                <ColumnDefinition Width="102"/>
                                <ColumnDefinition Width="102"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Padding="8,6"
                                HorizontalAlignment="Right"
                                FontSize="12"
                                FontWeight="Bold"
                                Text="Net Income (plug)"/>

                            <Border Grid.Column="1"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="1,0,0,0">
                                <TextBlock Foreground="{StaticResource EmeraldTextBrush}"
                                           Style="{StaticResource FooterNumericStyle}"
                                           Text="{x:Bind Totals.NetIncomeIsDebitDisplay, Mode=OneWay}"/>
                            </Border>
                            <TextBlock Grid.Column="2"
                                       Foreground="{StaticResource EmeraldTextBrush}"
                                       Style="{StaticResource FooterNumericStyle}"
                                       Text="{x:Bind Totals.NetIncomeIsCreditDisplay, Mode=OneWay}"/>

                            <Border Grid.Column="3"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="1,0,0,0">
                                <TextBlock Foreground="{StaticResource SkyTextBrush}"
                                           Style="{StaticResource FooterNumericStyle}"
                                           Text="{x:Bind Totals.NetIncomeBsDebitDisplay, Mode=OneWay}"/>
                            </Border>
                            <TextBlock Grid.Column="4"
                                       Foreground="{StaticResource SkyTextBrush}"
                                       Style="{StaticResource FooterNumericStyle}"
                                       Text="{x:Bind Totals.NetIncomeBsCreditDisplay, Mode=OneWay}"/>
                        </Grid>
                    </Border>

                    <!-- Baris 3: Total (after plug) -->
                    <Border Background="{StaticResource PrimaryTintBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="872"/>
                                <ColumnDefinition Width="102"/>
                                <ColumnDefinition Width="102"/>
                                <ColumnDefinition Width="102"/>
                                <ColumnDefinition Width="102"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Padding="8,6"
                                HorizontalAlignment="Right"
                                FontSize="12"
                                FontWeight="Bold"
                                Text="Total (after plug)"/>

                            <Border Grid.Column="1"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="1,0,0,0">
                                <TextBlock Foreground="{StaticResource EmeraldTextBrush}"
                                           Style="{StaticResource FooterNumericStyle}"
                                           Text="{x:Bind Totals.AfterPlugIsDebitDisplay, Mode=OneWay}"/>
                            </Border>
                            <TextBlock Grid.Column="2"
                                       Foreground="{StaticResource EmeraldTextBrush}"
                                       Style="{StaticResource FooterNumericStyle}"
                                       Text="{x:Bind Totals.AfterPlugIsCreditDisplay, Mode=OneWay}"/>

                            <Border Grid.Column="3"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="1,0,0,0">
                                <TextBlock Foreground="{StaticResource SkyTextBrush}"
                                           Style="{StaticResource FooterNumericStyle}"
                                           Text="{x:Bind Totals.AfterPlugBsDebitDisplay, Mode=OneWay}"/>
                            </Border>
                            <TextBlock Grid.Column="4"
                                       Foreground="{StaticResource SkyTextBrush}"
                                       Style="{StaticResource FooterNumericStyle}"
                                       Text="{x:Bind Totals.AfterPlugBsCreditDisplay, Mode=OneWay}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ================= CAPTION ================= -->
                <TextBlock
                    Grid.Row="3"
                    Padding="0,8"
                    HorizontalAlignment="Center"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Worksheet - 10 column accounting worksheet"/>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>