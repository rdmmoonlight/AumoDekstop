<UserControl
    x:Class="AumoDekstop.Features.Reports.GeneralLedgers.Cards.GeneralLedgersCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:AumoDekstop.Features.Reports.GeneralLedgers"
    mc:Ignorable="d">

    <Border
        CornerRadius="8"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

        <Grid RowDefinitions="Auto,Auto">
            <!-- Header Akun / Collapsible Bar -->
            <Button
                Grid.Row="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Padding="16,12"
                CornerRadius="0"
                BorderThickness="0"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                Click="OnHeaderClicked">

                <Grid ColumnDefinitions="*,Auto">
                    <!-- Kiri: Chevron + Kode & Nama Akun + Jumlah Transaksi -->
                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="12"
                        VerticalAlignment="Center">

                        <!-- Chevron dengan animasi rotasi 90 derajat saat expanded -->
                        <FontIcon
                            x:Name="ChevronIcon"
                            Glyph="&#xE76C;"
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5">
                            <FontIcon.RenderTransform>
                                <RotateTransform x:Name="ChevronRotateTransform"
                                                 Angle="90"/>
                            </FontIcon.RenderTransform>
                        </FontIcon>

                        <StackPanel Spacing="2"
                                    VerticalAlignment="Center">
                            <TextBlock FontSize="14"
                                       FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis">
                                <Run
                                    x:Name="AccountCodeRun"
                                    FontFamily="Consolas"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Run Text=" "/>
                                <Run
                                    x:Name="AccountNameRun"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                            </TextBlock>

                            <TextBlock
                                x:Name="TransactionCountText"
                                Text="0 Transaksi"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Kanan: Saldo Akhir -->
                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <TextBlock
                            Text="Saldo Akhir"
                            FontSize="12"
                            HorizontalAlignment="Right"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock
                            x:Name="EndingBalanceText"
                            Text="Rp 0"
                            FontFamily="Consolas"
                            FontSize="14"
                            FontWeight="Bold"
                            HorizontalAlignment="Right"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Body: Tabel Detail Jurnal (v-show="isExpanded") -->
            <Border
                x:Name="BodyContainer"
                Grid.Row="1"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Visibility="Visible">

                <!-- Tempat GeneralLedgersTable (pengganti LedgerTable.vue) -->
                <ContentPresenter x:Name="TableHost"/>
            </Border>
        </Grid>
    </Border>
</UserControl>