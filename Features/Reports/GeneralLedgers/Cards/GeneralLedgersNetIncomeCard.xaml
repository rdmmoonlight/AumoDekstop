<UserControl
    x:Class="AumoDekstop.Features.Reports.GeneralLedgers.GeneralLedgersNetIncomeCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 1. Total Pendapatan -->
        <Border
            Grid.Column="0"
            CornerRadius="8"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            Padding="16">
            <StackPanel Spacing="8">
                <TextBlock
                    Text="TOTAL PENDAPATAN"
                    FontSize="11"
                    FontWeight="SemiBold"
                    CharacterSpacing="40"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock
                    x:Name="TotalRevenueText"
                    Text="Rp 0"
                    FontFamily="Consolas"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- 2. Total Beban -->
        <Border
            Grid.Column="1"
            CornerRadius="8"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            Padding="16">
            <StackPanel Spacing="8">
                <TextBlock
                    Text="TOTAL BEBAN"
                    FontSize="11"
                    FontWeight="SemiBold"
                    CharacterSpacing="40"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock
                    x:Name="TotalExpenseText"
                    Text="Rp 0"
                    FontFamily="Consolas"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- 3. Laba / Rugi Bersih -->
        <Border
            x:Name="NetIncomeBorder"
            Grid.Column="2"
            CornerRadius="8"
            BorderThickness="1"
            Padding="16">
            <StackPanel Spacing="8">
                <TextBlock
                    x:Name="NetIncomeLabelText"
                    Text="LABA BERSIH (NET INCOME)"
                    FontSize="11"
                    FontWeight="SemiBold"
                    CharacterSpacing="40"/>
                <TextBlock
                    x:Name="NetIncomeValueText"
                    Text="Rp 0"
                    FontFamily="Consolas"
                    FontSize="22"
                    FontWeight="Bold"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>