<Page
    x:Class="AumoDekstop.Features.Reports.FinancialStatements.Views.StatementOfFinancialPositionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AumoDekstop.Features.Reports.FinancialStatements.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <SolidColorBrush x:Key="Gray50Brush" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="Gray200Brush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="Gray500Brush" Color="#6B7280"/>
        <SolidColorBrush x:Key="Gray700Brush" Color="#374151"/>
        <SolidColorBrush x:Key="Gray900Brush" Color="#111827"/>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="24">
            <!-- Header Halaman & Filter Post-Closing -->
            <Border
                Padding="0,0,0,20"
                BorderBrush="{StaticResource Gray200Brush}"
                BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                        <TextBlock
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="{StaticResource Gray900Brush}"
                            Text="Laporan Posisi Keuangan (Neraca)"/>

                        <TextBlock
                            FontSize="14"
                            Foreground="{StaticResource Gray500Brush}"
                            Text="{x:Bind ViewModel.PeriodSubtitle, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasPeriod, Mode=OneWay}"/>
                    </StackPanel>

                    <!-- Toggle Status Post-Closing -->
                    <Border
                        Grid.Column="1"
                        Padding="16,8"
                        VerticalAlignment="Center"
                        Background="{StaticResource Gray50Brush}"
                        BorderBrush="{StaticResource Gray200Brush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <CheckBox
                            MinWidth="0"
                            Content="Tampilkan Setelah Penutupan (Post-Closing)"
                            FontSize="14"
                            FontWeight="Medium"
                            Foreground="{StaticResource Gray700Brush}"
                            IsChecked="{x:Bind ViewModel.IsPostClosing, Mode=TwoWay}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- State 1: Loading -->
            <controls:LoadingStateControl
                IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                Message="Memuat Laporan Posisi Keuangan..."
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>

            <!-- State 2: Error -->
            <controls:ErrorAlertControl
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                RetryCommand="{x:Bind ViewModel.LoadCommand}"
                Title="Gagal Memuat Laporan Posisi Keuangan"
                Visibility="{x:Bind ViewModel.ShowErrorState, Mode=OneWay}"/>

            <!-- State 3: Data Kosong / Periode Tidak Ada -->
            <controls:NoPeriodCardControl
                ActionClicked="NoPeriodCard_ActionClicked"
                Message="Silakan buat atau aktifkan periode akuntansi untuk melihat Laporan Posisi Keuangan."
                Title="Belum Ada Periode Aktif"
                Visibility="{x:Bind ViewModel.ShowNoPeriodState, Mode=OneWay}"/>

            <!-- State 4: Tampilan Data Utama -->
            <controls:FinancialPositionTableControl
                Data="{x:Bind ViewModel.Data, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.ShowDataState, Mode=OneWay}"/>
        </StackPanel>
    </ScrollViewer>
</Page>