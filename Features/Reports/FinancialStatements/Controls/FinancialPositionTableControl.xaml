<UserControl
    x:Class="AumoDekstop.Features.Reports.FinancialStatements.Controls.FinancialPositionTableControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AumoDekstop.Features.Reports.FinancialStatements.Models"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Tailwind Gray & Emerald Palette -->
        <SolidColorBrush x:Key="Gray50Brush" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="Gray50HalfBrush" Color="#80F9FAFB"/>
        <SolidColorBrush x:Key="Gray100Brush" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="Gray200Brush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="Gray200Alpha80Brush" Color="#CCE5E7EB"/>
        <SolidColorBrush x:Key="Gray300Brush" Color="#D1D5DB"/>
        <SolidColorBrush x:Key="Gray500Brush" Color="#6B7280"/>
        <SolidColorBrush x:Key="Gray800Brush" Color="#1F2937"/>
        <SolidColorBrush x:Key="Gray900Brush" Color="#111827"/>

        <SolidColorBrush x:Key="Emerald50Alpha40Brush" Color="#66ECFDF5"/>
        <SolidColorBrush x:Key="Emerald100Brush" Color="#D1FAE5"/>
        <SolidColorBrush x:Key="Emerald100Alpha70Brush" Color="#B3D1FAE5"/>
        <SolidColorBrush x:Key="Emerald300Brush" Color="#6EE7B7"/>
        <SolidColorBrush x:Key="Emerald600Brush" Color="#059669"/>
        <SolidColorBrush x:Key="Emerald800Brush" Color="#065F46"/>
        <SolidColorBrush x:Key="Emerald900Brush" Color="#064E3B"/>
        <SolidColorBrush x:Key="Emerald950Brush" Color="#022C22"/>

        <!-- Reusable DataTemplate untuk Item Neraca (pl-12 = 48px) -->
        <DataTemplate x:Key="BalanceSheetItemTemplate" x:DataType="models:BalanceSheetItem">
            <Border
                Padding="48,10,24,10"
                BorderBrush="{StaticResource Gray100Brush}"
                BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="Consolas, Cascadia Mono, Segoe UI"
                            FontSize="12"
                            Foreground="{StaticResource Gray500Brush}"
                            Text="{x:Bind AccountCode}"/>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="{StaticResource Gray800Brush}"
                            Text="{x:Bind AccountName}"
                            TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontFamily="Consolas, Cascadia Mono, Segoe UI"
                        FontSize="14"
                        Foreground="{StaticResource Gray900Brush}"
                        Text="{x:Bind FormattedAmount}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Outer Card (rounded-lg border border-gray-200 bg-white) -->
    <Border
        Background="White"
        BorderBrush="{StaticResource Gray200Brush}"
        BorderThickness="1"
        CornerRadius="8">

        <StackPanel>
            <!-- Header Laporan -->
            <Border
                Padding="24,16"
                Background="{StaticResource Gray50Brush}"
                BorderBrush="{StaticResource Gray200Brush}"
                BorderThickness="0,0,0,1"
                CornerRadius="8,8,0,0">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Gray500Brush}"
                        Text="KODE / AKUN"/>

                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Gray500Brush}"
                        Text="JUMLAH (IDR)"/>
                </Grid>
            </Border>

            <!-- ========================================================= -->
            <!-- 1. ASET                                                   -->
            <!-- ========================================================= -->
            <Border Padding="24,12" Background="{StaticResource Emerald900Brush}">
                <TextBlock
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="1. ASET"/>
            </Border>

            <!-- Aset Lancar -->
            <Border
                Padding="32,10,24,10"
                Background="{StaticResource Gray50HalfBrush}"
                BorderBrush="{StaticResource Gray100Brush}"
                BorderThickness="0,0,0,1">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource Emerald800Brush}"
                    Text="{x:Bind SafeData.Assets.CurrentAssets.UpperTitle, Mode=OneWay}"/>
            </Border>

            <ItemsRepeater
                ItemTemplate="{StaticResource BalanceSheetItemTemplate}"
                ItemsSource="{x:Bind SafeData.Assets.CurrentAssets.Items, Mode=OneWay}"/>

            <Border
                Padding="32,10,24,10"
                Background="{StaticResource Emerald50Alpha40Brush}"
                BorderBrush="{StaticResource Emerald100Brush}"
                BorderThickness="0,1,0,1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Emerald900Brush}"
                        Text="{x:Bind SafeData.Assets.CurrentAssets.TotalSectionLabel, Mode=OneWay}"/>

                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontFamily="Consolas, Cascadia Mono, Segoe UI"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Emerald900Brush}"
                        Text="{x:Bind SafeData.Assets.CurrentAssets.FormattedSubtotal, Mode=OneWay}"/>
                </Grid>
            </Border>

            <!-- Aset Tidak Lancar -->
            <Border
                Padding="32,10,24,10"
                Background="{StaticResource Gray50HalfBrush}"
                BorderBrush="{StaticResource Gray100Brush}"
                BorderThickness="0,0,0,1">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource Emerald800Brush}"
                    Text="{x:Bind SafeData.Assets.NonCurrentAssets.UpperTitle, Mode=OneWay}"/>
            </Border>

            <ItemsRepeater
                ItemTemplate="{StaticResource BalanceSheetItemTemplate}"
                ItemsSource="{x:Bind SafeData.Assets.NonCurrentAssets.Items, Mode=OneWay}"/>

            <Border
                Padding="32,10,24,10"
                Background="{StaticResource Emerald50Alpha40Brush}"
                BorderBrush="{StaticResource Emerald100Brush}"
                BorderThickness="0,1,0,1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Emerald900Brush}"
                        Text="{x:Bind SafeData.Assets.NonCurrentAssets.TotalSectionLabel, Mode=OneWay}"/>

                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontFamily="Consolas, Cascadia Mono, Segoe UI"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Emerald900Brush}"
                        Text="{x:Bind SafeData.Assets.NonCurrentAssets.FormattedSubtotal, Mode=OneWay}"/>
                </Grid>
            </Border>

            <!-- Total Aset -->
            <Border
                Padding="24,14"
                Background="{StaticResource Emerald100Alpha70Brush}"
                BorderBrush="{StaticResource Emerald300Brush}"
                BorderThickness="0,2,0,2">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{StaticResource Emerald950Brush}"
                        Text="TOTAL ASET"/>

                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontFamily="Consolas, Cascadia Mono, Segoe UI"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="{StaticResource Emerald950Brush}"
                        Text="{x:Bind SafeData.Assets.FormattedTotalAssets, Mode=OneWay}"/>
                </Grid>
            </Border>

            <!-- ========================================================= -->
            <!-- 2. LIABILITAS                                             -->
            <!-- ========================================================= -->
            <Border Padding="24,12" Background="{StaticResource Emerald900Brush}">
                <TextBlock
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="2. LIABILITAS"/>
            </Border>

            <!-- Liabilitas Jangka Pendek -->
            <Border
                Padding="32,10,24,10"
                Background="{StaticResource Gray50HalfBrush}"
                BorderBrush="{StaticResource Gray100Brush}"
                BorderThickness="0,0,0,1">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource Emerald800Brush}"
                    Text="{x:Bind SafeData.Liabilities.CurrentLiabilities.UpperTitle, Mode=OneWay}"/>
            </Border>

            <ItemsRepeater
                ItemTemplate="{StaticResource BalanceSheetItemTemplate}"
                ItemsSource="{x:Bind SafeData.Liabilities.CurrentLiabilities.Items, Mode=OneWay}"/>

            <Border
                Padding="32,10,24,10"
                Background="{StaticResource Emerald50Alpha40Brush}"
                BorderBrush="{StaticResource Emerald100Brush}"
                BorderThickness="0,1,0,1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Emerald900Brush}"
                        Text="{x:Bind SafeData.Liabilities.CurrentLiabilities.TotalSectionLabel, Mode=OneWay}"/>

                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontFamily="Consolas, Cascadia Mono, Segoe UI"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Emerald900Brush}"
                        Text="{x:Bind SafeData.Liabilities.CurrentLiabilities.FormattedSubtotal, Mode=OneWay}"/>
                </Grid>
            </Border>

            <!-- Liabilitas Jangka Panjang -->
            <Border
                Padding="32,10,24,10"
                Background="{StaticResource Gray50HalfBrush}"
                BorderBrush="{StaticResource Gray100Brush}"
                BorderThickness="0,0,0,1">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource Emerald800Brush}"
                    Text="{x:Bind SafeData.Liabilities.NonCurrentLiabilities.UpperTitle, Mode=OneWay}"/>
            </Border>

            <ItemsRepeater
                ItemTemplate="{StaticResource BalanceSheetItemTemplate}"
                ItemsSource="{x:Bind SafeData.Liabilities.NonCurrentLiabilities.Items, Mode=OneWay}"/>

            <Border
                Padding="32,10,24,10"
                Background="{StaticResource Emerald50Alpha40Brush}"
                BorderBrush="{StaticResource Emerald100Brush}"
                BorderThickness="0,1,0,1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Emerald900Brush}"
                        Text="{x:Bind SafeData.Liabilities.NonCurrentLiabilities.TotalSectionLabel, Mode=OneWay}"/>

                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontFamily="Consolas, Cascadia Mono, Segoe UI"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Emerald900Brush}"
                        Text="{x:Bind SafeData.Liabilities.NonCurrentLiabilities.FormattedSubtotal, Mode=OneWay}"/>
                </Grid>
            </Border>

            <!-- Total Liabilitas -->
            <Border
                Padding="24,12"
                Background="{StaticResource Gray200Alpha80Brush}"
                BorderBrush="{StaticResource Gray300Brush}"
                BorderThickness="0,1,0,1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{StaticResource Gray900Brush}"
                        Text="TOTAL LIABILITAS"/>

                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontFamily="Consolas, Cascadia Mono, Segoe UI"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="{StaticResource Gray900Brush}"
                        Text="{x:Bind SafeData.Liabilities.FormattedTotalLiabilities, Mode=OneWay}"/>
                </Grid>
            </Border>

            <!-- ========================================================= -->
            <!-- 3. EKUITAS                                                -->
            <!-- ========================================================= -->
            <Border Padding="24,12" Background="{StaticResource Emerald900Brush}">
                <TextBlock
                    FontSize="12"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="3. EKUITAS"/>
            </Border>

            <ItemsRepeater
                ItemTemplate="{StaticResource BalanceSheetItemTemplate}"
                ItemsSource="{x:Bind SafeData.Equity.Section.Items, Mode=OneWay}"/>

            <!-- Total Ekuitas -->
            <Border
                Padding="24,12"
                Background="{StaticResource Gray200Alpha80Brush}"
                BorderBrush="{StaticResource Gray300Brush}"
                BorderThickness="0,1,0,1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{StaticResource Gray900Brush}"
                        Text="TOTAL EKUITAS"/>

                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontFamily="Consolas, Cascadia Mono, Segoe UI"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="{StaticResource Gray900Brush}"
                        Text="{x:Bind SafeData.Equity.FormattedTotalEquity, Mode=OneWay}"/>
                </Grid>
            </Border>

            <!-- ========================================================= -->
            <!-- TOTAL LIABILITAS & EKUITAS (bg-emerald-600 text-white)    -->
            <!-- ========================================================= -->
            <Border
                Padding="24,16"
                Background="{StaticResource Emerald600Brush}"
                CornerRadius="0,0,8,8">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="TOTAL LIABILITAS &amp; EKUITAS"/>

                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontFamily="Consolas, Cascadia Mono, Segoe UI"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{x:Bind SafeData.FormattedTotalLiabilitiesAndEquity, Mode=OneWay}"/>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>