<UserControl
    x:Class="AumoDekstop.Features.Reports.FinancialStatements.Controls.NoPeriodCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Tailwind Gray & Emerald Palette -->
        <SolidColorBrush x:Key="Gray50HalfBrush" Color="#80F9FAFB"/>
        <SolidColorBrush x:Key="Gray100Brush" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="Gray300Brush" Color="#D1D5DB"/>
        <SolidColorBrush x:Key="Gray500Brush" Color="#6B7280"/>
        <SolidColorBrush x:Key="Gray900Brush" Color="#111827"/>
        <SolidColorBrush x:Key="Emerald600Brush" Color="#059669"/>
    </UserControl.Resources>

    <Grid>
        <!-- Pengganti border-2 border-dashed border-gray-300 bg-gray-50/50 -->
        <Rectangle
            Fill="{StaticResource Gray50HalfBrush}"
            RadiusX="8"
            RadiusY="8"
            Stroke="{StaticResource Gray300Brush}"
            StrokeDashArray="4 4"
            StrokeThickness="2"/>

        <!-- Content Container (p-12 = 48px) -->
        <StackPanel
            Padding="48"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <!-- Circle Icon Badge (h-12 w-12 rounded-full bg-gray-100 text-gray-500) -->
            <Border
                Width="48"
                Height="48"
                Margin="0,0,0,16"
                HorizontalAlignment="Center"
                Background="{StaticResource Gray100Brush}"
                CornerRadius="24">
                <FontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                    FontSize="20"
                    Foreground="{StaticResource Gray500Brush}"
                    Glyph="&#xE787;"/>
            </Border>

            <!-- Title -->
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="{StaticResource Gray900Brush}"
                Text="{x:Bind EffectiveTitle, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap"/>

            <!-- Message (max-w-md = 448px) -->
            <TextBlock
                MaxWidth="448"
                Margin="0,4,0,0"
                HorizontalAlignment="Center"
                FontSize="14"
                Foreground="{StaticResource Gray500Brush}"
                Text="{x:Bind EffectiveMessage, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap"/>

            <!-- Action Button (tampil jika ActionClicked atau ActionCommand terpasang) -->
            <Button
                Margin="0,24,0,0"
                Padding="16,8"
                HorizontalAlignment="Center"
                Background="{StaticResource Emerald600Brush}"
                BorderThickness="0"
                Click="ActionButton_Click"
                CornerRadius="6"
                Foreground="White"
                Visibility="{x:Bind HasActionHandler, Mode=OneWay}">
                <TextBlock
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="{x:Bind EffectiveActionLabel, Mode=OneWay}"/>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>