<UserControl
    x:Class="AumoDekstop.Features.Reports.FinancialStatements.Controls.CashFlowTableControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AumoDekstop.Features.Reports.FinancialStatements.Models"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- Tailwind Gray & Emerald Palette -->
        <SolidColorBrush x:Key="Gray50Brush" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="Gray50HalfBrush" Color="#80F9FAFB"/>
        <SolidColorBrush x:Key="Gray100Brush" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="Gray200Brush" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="Gray300Brush" Color="#D1D5DB"/>
        <SolidColorBrush x:Key="Gray500Brush" Color="#6B7280"/>
        <SolidColorBrush x:Key="Gray700Brush" Color="#374151"/>
        <SolidColorBrush x:Key="Gray800Brush" Color="#1F2937"/>
        <SolidColorBrush x:Key="Gray900Brush" Color="#111827"/>

        <SolidColorBrush x:Key="Emerald50Alpha40Brush" Color="#66ECFDF5"/>
        <SolidColorBrush x:Key="Emerald100Brush" Color="#D1FAE5"/>
        <SolidColorBrush x:Key="Emerald600Brush" Color="#059669"/>
        <SolidColorBrush x:Key="Emerald800Brush" Color="#065F46"/>
        <SolidColorBrush x:Key="Emerald900Brush" Color="#064E3B"/>
    </UserControl.Resources>

    <!-- Outer Card (rounded-lg border border-gray-200 bg-white) -->
    <Border
        Background="White"
        BorderBrush="{StaticResource Gray200Brush}"
        BorderThickness="1"
        CornerRadius="8">

        <StackPanel>
            <!-- Table Header (bg-gray-50 border-b border-gray-200) -->
            <Border
                Padding="24,16"
                Background="{StaticResource Gray50Brush}"
                BorderBrush="{StaticResource Gray200Brush}"
                BorderThickness="0,0,0,1"
                CornerRadius="8,8,0,0">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Gray500Brush}"
                        Text="AKTIVITAS ARUS KAS"/>

                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Gray500Brush}"
                        Text="JUMLAH (IDR)"/>
                </Grid>
            </Border>

            <!-- ========================================================= -->
            <!-- 1. ARUS KAS DARI AKTIVITAS OPERASIONAL                     -->
            <!-- ========================================================= -->
            <Border
                Padding="24,12"
                Background="{StaticResource Gray50HalfBrush}"
                BorderBrush="{StaticResource Gray100Brush}"
                BorderThickness="0,0,0,1">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource Emerald800Brush}"
                    Text="{x:Bind SafeData.OperatingActivities.UpperTitle, Mode=OneWay}"/>
            </Border>

            <ItemsRepeater ItemsSource="{x:Bind SafeData.OperatingActivities.Items, Mode=OneWay}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:CashFlowItem">
                        <Border
                            Padding="40,12,24,12"
                            BorderBrush="{StaticResource Gray100Brush}"
                            BorderThickness="0,0,0,1">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource Gray800Brush}"
                                    Text="{x:Bind Description}"
                                    TextWrapping="Wrap"/>

                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                    FontSize="14"
                                    Foreground="{StaticResource Gray900Brush}"
                                    Text="{x:Bind FormattedAmount}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <Border
                Padding="24,12"
                Background="{StaticResource Emerald50Alpha40Brush}"
                BorderBrush="{StaticResource Emerald100Brush}"
                BorderThickness="0,1,0,1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Emerald900Brush}"
                        Text="{x:Bind SafeData.OperatingActivities.NetCashFlowLabel, Mode=OneWay}"
                        TextWrapping="Wrap"/>

                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontFamily="Consolas, Cascadia Mono, Segoe UI"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Emerald900Brush}"
                        Text="{x:Bind SafeData.OperatingActivities.FormattedSubtotal, Mode=OneWay}"/>
                </Grid>
            </Border>

            <!-- ========================================================= -->
            <!-- 2. ARUS KAS DARI AKTIVITAS INVESTASI                       -->
            <!-- ========================================================= -->
            <Border
                Padding="24,12"
                Background="{StaticResource Gray50HalfBrush}"
                BorderBrush="{StaticResource Gray100Brush}"
                BorderThickness="0,0,0,1">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource Emerald800Brush}"
                    Text="{x:Bind SafeData.InvestingActivities.UpperTitle, Mode=OneWay}"/>
            </Border>

            <ItemsRepeater ItemsSource="{x:Bind SafeData.InvestingActivities.Items, Mode=OneWay}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:CashFlowItem">
                        <Border
                            Padding="40,12,24,12"
                            BorderBrush="{StaticResource Gray100Brush}"
                            BorderThickness="0,0,0,1">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource Gray800Brush}"
                                    Text="{x:Bind Description}"
                                    TextWrapping="Wrap"/>

                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                    FontSize="14"
                                    Foreground="{StaticResource Gray900Brush}"
                                    Text="{x:Bind FormattedAmount}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <Border
                Padding="24,12"
                Background="{StaticResource Emerald50Alpha40Brush}"
                BorderBrush="{StaticResource Emerald100Brush}"
                BorderThickness="0,1,0,1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Emerald900Brush}"
                        Text="{x:Bind SafeData.InvestingActivities.NetCashFlowLabel, Mode=OneWay}"
                        TextWrapping="Wrap"/>

                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontFamily="Consolas, Cascadia Mono, Segoe UI"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Emerald900Brush}"
                        Text="{x:Bind SafeData.InvestingActivities.FormattedSubtotal, Mode=OneWay}"/>
                </Grid>
            </Border>

            <!-- ========================================================= -->
            <!-- 3. ARUS KAS DARI AKTIVITAS PENDANAAN                       -->
            <!-- ========================================================= -->
            <Border
                Padding="24,12"
                Background="{StaticResource Gray50HalfBrush}"
                BorderBrush="{StaticResource Gray100Brush}"
                BorderThickness="0,0,0,1">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource Emerald800Brush}"
                    Text="{x:Bind SafeData.FinancingActivities.UpperTitle, Mode=OneWay}"/>
            </Border>

            <ItemsRepeater ItemsSource="{x:Bind SafeData.FinancingActivities.Items, Mode=OneWay}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:CashFlowItem">
                        <Border
                            Padding="40,12,24,12"
                            BorderBrush="{StaticResource Gray100Brush}"
                            BorderThickness="0,0,0,1">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource Gray800Brush}"
                                    Text="{x:Bind Description}"
                                    TextWrapping="Wrap"/>

                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                    FontSize="14"
                                    Foreground="{StaticResource Gray900Brush}"
                                    Text="{x:Bind FormattedAmount}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <Border
                Padding="24,12"
                Background="{StaticResource Emerald50Alpha40Brush}"
                BorderBrush="{StaticResource Emerald100Brush}"
                BorderThickness="0,1,0,1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Emerald900Brush}"
                        Text="{x:Bind SafeData.FinancingActivities.NetCashFlowLabel, Mode=OneWay}"
                        TextWrapping="Wrap"/>

                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontFamily="Consolas, Cascadia Mono, Segoe UI"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Emerald900Brush}"
                        Text="{x:Bind SafeData.FinancingActivities.FormattedSubtotal, Mode=OneWay}"/>
                </Grid>
            </Border>

            <!-- ========================================================= -->
            <!-- REKONSILIASI KAS                                          -->
            <!-- ========================================================= -->
            <Border
                Padding="24,14"
                Background="{StaticResource Gray100Brush}"
                BorderBrush="{StaticResource Gray300Brush}"
                BorderThickness="0,2,0,1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Gray900Brush}"
                        Text="Kenaikan / (Penurunan) Bersih Kas"/>

                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontFamily="Consolas, Cascadia Mono, Segoe UI"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource Gray900Brush}"
                        Text="{x:Bind SafeData.FormattedNetChangeInCash, Mode=OneWay}"/>
                </Grid>
            </Border>

            <Border
                Padding="24,12"
                BorderBrush="{StaticResource Gray100Brush}"
                BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="Medium"
                        Foreground="{StaticResource Gray700Brush}"
                        Text="Saldo Kas Awal Periode"/>

                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontFamily="Consolas, Cascadia Mono, Segoe UI"
                        FontSize="14"
                        Foreground="{StaticResource Gray900Brush}"
                        Text="{x:Bind SafeData.FormattedBeginningCashBalance, Mode=OneWay}"/>
                </Grid>
            </Border>

            <!-- ========================================================= -->
            <!-- SALDO KAS AKHIR PERIODE (bg-emerald-600 text-white)       -->
            <!-- ========================================================= -->
            <Border
                Padding="24,16"
                Background="{StaticResource Emerald600Brush}"
                CornerRadius="0,0,8,8">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="SALDO KAS AKHIR PERIODE"/>

                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontFamily="Consolas, Cascadia Mono, Segoe UI"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="{x:Bind SafeData.FormattedEndingCashBalance, Mode=OneWay}"/>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>