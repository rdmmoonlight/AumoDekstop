<Page
    x:Class="AumoDekstop.Features.ChartOfAccounts.Views.ChartOfAccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AumoDekstop.Features.ChartOfAccounts.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <Grid Padding="32"
          RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Halaman -->
        <Grid Grid.Row="0"
              ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Spacing="4">
                <TextBlock
                    Text="Bagan Akun (Chart of Accounts)"
                    Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock
                    x:Name="SubtitleText"
                    Text="Kelola daftar akun buku besar untuk pencatatan transaksi keuangan."
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <Button
                    x:Name="RefreshButton"
                    Click="RefreshButton_Click"
                    ToolTipService.ToolTip="Muat ulang data">
                    <FontIcon Glyph="&#xE72C;"
                              FontSize="14"/>
                </Button>

                <Button
                    x:Name="CreateAccountButton"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="CreateAccountButton_Click">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <FontIcon Glyph="&#xE710;"
                                  FontSize="14"/>
                        <TextBlock Text="Tambah Akun"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Alert Error Jika Ada -->
        <InfoBar
            x:Name="ErrorInfoBar"
            Grid.Row="1"
            Severity="Error"
            Title="Gagal"
            IsOpen="False"
            IsClosable="True"
            Closed="ErrorInfoBar_Closed"/>

        <!-- Tabel Akun -->
        <controls:AccountsTableControl
            x:Name="AccountsTable"
            Grid.Row="2"
            EditAccountRequested="AccountsTable_EditAccountRequested"
            DeleteAccountRequested="AccountsTable_DeleteAccountRequested"/>
    </Grid>
</Page>