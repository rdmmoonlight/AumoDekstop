<UserControl
    x:Class="AumoDekstop.Features.ChartOfAccounts.Controls.AccountsTableControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AumoDekstop.Features.ChartOfAccounts.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Table Header -->
            <Grid
                Grid.Row="0"
                Padding="16,12"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="64"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Kode Akun"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="1"
                           Text="Nama Akun"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="2"
                           Text="Tipe"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="3"
                           Text="Peran"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="4"
                           Text="Status"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="5"
                           Text="Saldo Saat Ini"
                           HorizontalAlignment="Right"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="6"
                           Text="Aksi"
                           HorizontalAlignment="Right"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>

            <!-- Loading State -->
            <StackPanel
                x:Name="LoadingPanel"
                Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10"
                Margin="0,40"
                Visibility="Collapsed">
                <ProgressRing IsActive="True"
                              Width="20"
                              Height="20"/>
                <TextBlock Text="Memuat data akun..."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Empty State -->
            <TextBlock
                x:Name="EmptyStateText"
                Grid.Row="1"
                Text="Belum ada data akun buku besar."
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,40"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Visibility="Collapsed"/>

            <!-- Accounts List -->
            <ListView
                x:Name="AccountsListView"
                Grid.Row="1"
                ItemsSource="{x:Bind Accounts, Mode=OneWay}"
                SelectionMode="None"
                IsItemClickEnabled="False">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch"/>
                        <Setter Property="Padding"
                                Value="0"/>
                        <Setter Property="MinHeight"
                                Value="48"/>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Account">
                        <Grid
                            Padding="16,10"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="64"/>
                            </Grid.ColumnDefinitions>

                            <!-- Kode Akun (Monospace) -->
                            <TextBlock
                                Grid.Column="0"
                                Text="{x:Bind ReferenceNumber}"
                                FontFamily="Consolas"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"/>

                            <!-- Nama Akun -->
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind AccountName}"
                                TextTrimming="CharacterEllipsis"
                                Opacity="{x:Bind IsActive, Converter={StaticResource BoolToOpacityConverter}}"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"/>

                            <!-- Badge Tipe -->
                            <Border
                                Grid.Column="2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Padding="8,3"
                                CornerRadius="6"
                                Background="{x:Bind Type, Converter={StaticResource AccountTypeToBackgroundConverter}}">
                                <TextBlock
                                    Text="{x:Bind TypeLabel}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    FontWeight="SemiBold"
                                    Foreground="{x:Bind Type, Converter={StaticResource AccountTypeToForegroundConverter}}"/>
                            </Border>

                            <!-- Peran -->
                            <TextBlock
                                Grid.Column="3"
                                Text="{x:Bind Role, Converter={StaticResource AccountRoleDisplayConverter}}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"/>

                            <!-- Badge Status -->
                            <Border
                                Grid.Column="4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Padding="8,3"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                Background="{x:Bind IsActive, Converter={StaticResource StatusToBackgroundConverter}}">
                                <TextBlock
                                    Text="{x:Bind IsActive, Converter={StaticResource StatusToTextConverter}}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    FontWeight="Medium"/>
                            </Border>

                            <!-- Saldo Saat Ini (Monospace, rata kanan) -->
                            <TextBlock
                                Grid.Column="5"
                                Text="{x:Bind Balance, Converter={StaticResource CurrencyIdrConverter}}"
                                FontFamily="Consolas"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"/>

                            <!-- Menu Aksi -->
                            <Button
                                Grid.Column="6"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="6"
                                ToolTipService.ToolTip="Buka menu">
                                <FontIcon Glyph="&#xE712;"
                                          FontSize="14"/>
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuFlyoutItem
                                            Text="Edit"
                                            Tag="{x:Bind}"
                                            Click="EditMenuItem_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE70F;"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem
                                            Text="Hapus"
                                            Tag="{x:Bind}"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Click="DeleteMenuItem_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;"
                                                          Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Border>
</UserControl>