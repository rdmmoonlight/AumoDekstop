<UserControl
    x:Class="AumoDekstop.Features.JournalEntry.JournalEntryFooterControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Padding="16"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Bagian Kiri: Status Keseimbangan -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="6">
                <TextBlock
                    FontSize="13"
                    FontWeight="Medium"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Status Keseimbangan" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <!-- Badge Balanced -->
                    <Border
                        Padding="10,4"
                        Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                        CornerRadius="12"
                        Visibility="{x:Bind IsBalanced, Mode=OneWay}">
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                            Text="Balanced (Seimbang)" />
                    </Border>

                    <!-- Badge Unbalanced -->
                    <Border
                        Padding="10,4"
                        Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                        CornerRadius="12"
                        Visibility="{x:Bind IsUnbalanced, Mode=OneWay}">
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Text="Unbalanced (Tidak Seimbang)" />
                    </Border>

                    <!-- Teks Selisih (Muncul jika Unbalanced) -->
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Text="{x:Bind DifferenceText, Mode=OneWay}"
                        Visibility="{x:Bind IsUnbalanced, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>

            <!-- Bagian Kanan: Total Debit & Total Kredit -->
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="24">

                <!-- Total Debit -->
                <StackPanel HorizontalAlignment="Right" Spacing="2">
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Total Debit" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontFamily="Consolas, Cascadia Mono, Segoe UI"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Text="{x:Bind FormattedTotalDebit, Mode=OneWay}" />
                </StackPanel>

                <!-- Total Kredit -->
                <StackPanel HorizontalAlignment="Right" Spacing="2">
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Total Kredit" />
                    <TextBlock
                        HorizontalAlignment="Right"
                        FontFamily="Consolas, Cascadia Mono, Segoe UI"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Text="{x:Bind FormattedTotalCredit, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>