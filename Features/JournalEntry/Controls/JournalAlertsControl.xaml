<UserControl
    x:Class="AumoDekstop.Features.JournalEntry.JournalAlertsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="12">
        <!-- Alert Pesan Error / Warning General -->
        <InfoBar
            Title="Terjadi Kesalahan"
            IsClosable="False"
            IsOpen="{x:Bind HasErrorMessage, Mode=OneWay}"
            Message="{x:Bind ErrorMessage, Mode=OneWay}"
            Severity="Error" />

        <!-- Alert Status Jurnal Tidak Seimbang (Unbalanced) -->
        <InfoBar
            Title="Jurnal Tidak Seimbang"
            IsClosable="False"
            IsOpen="{x:Bind IsUnbalancedVisible, Mode=OneWay}"
            Message="{x:Bind UnbalancedMessage, Mode=OneWay}"
            Severity="Error" />

        <!-- Alert Informasi Status Posted -->
        <InfoBar
            Title="Jurnal Terposting"
            IsClosable="False"
            IsOpen="{x:Bind IsPosted, Mode=OneWay}"
            Message="Entri jurnal ini telah diposting ke buku besar dan nilainya telah memperbarui saldo akun."
            Severity="Success" />

        <!-- Alert Informasi Status Cancelled -->
        <InfoBar
            Title="Jurnal Dibatalkan"
            IsClosable="False"
            IsOpen="{x:Bind IsCancelled, Mode=OneWay}"
            Message="Entri jurnal ini telah dibatalkan dan tidak berlaku lagi dalam laporan keuangan."
            Severity="Error" />
    </StackPanel>
</UserControl>