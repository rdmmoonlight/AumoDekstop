<UserControl
    x:Class="AumoDekstop.Features.JournalEntry.Controls.JournalLinesTableControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AumoDekstop.Features.JournalEntry.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="RootControl"
    mc:Ignorable="d">

    <StackPanel Spacing="16">
        <!-- Container Tabel -->
        <Border
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6">

            <StackPanel>
                <!-- Table Header -->
                <Border
                    Padding="12,10"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" MinWidth="240" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="#" />

                        <TextBlock
                            Grid.Column="1"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Akun Buku Besar" />

                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Debit" />

                        <TextBlock
                            Grid.Column="3"
                            HorizontalAlignment="Right"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Kredit" />

                        <TextBlock
                            Grid.Column="4"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Aksi"
                            Visibility="{x:Bind IsEditable, Mode=OneWay}" />
                    </Grid>
                </Border>

                <!-- Empty State (Jika Lines kosong) -->
                <Border
                    Height="96"
                    Padding="16"
                    Visibility="{x:Bind IsEmpty, Mode=OneWay}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Belum ada rincian baris jurnal. Silakan tambah baris transaksi." />
                </Border>

                <!-- Table Body (Daftar Baris Jurnal) -->
                <ItemsRepeater
                    x:Name="LinesRepeater"
                    ItemsSource="{x:Bind Lines, Mode=OneWay}"
                    Visibility="{x:Bind HasLines, Mode=OneWay}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="local:JournalLineRowItem">
                            <Border
                                Padding="12,8"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" MinWidth="240" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Nomor Urut -->
                                    <TextBlock
                                        Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontWeight="Medium"
                                        Text="{x:Bind RowNumber, Mode=OneWay}" />

                                    <!-- Pilihan Akun -->
                                    <ComboBox
                                        Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        DisplayMemberPath="DisplayLabel"
                                        IsEnabled="{Binding IsEditable, ElementName=RootControl}"
                                        ItemsSource="{Binding Accounts, ElementName=RootControl}"
                                        PlaceholderText="Pilih Akun"
                                        SelectedValue="{x:Bind AccountId, Mode=TwoWay}"
                                        SelectedValuePath="Id"
                                        SelectionChanged="AccountComboBox_SelectionChanged" />

                                    <!-- Input Debit -->
                                    <NumberBox
                                        Grid.Column="2"
                                        HorizontalAlignment="Stretch"
                                        FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                        IsEnabled="{Binding IsEditable, ElementName=RootControl}"
                                        Minimum="0"
                                        SpinButtonPlacementMode="Hidden"
                                        Value="{x:Bind DebitValue, Mode=TwoWay}"
                                        ValueChanged="DebitNumberBox_ValueChanged">
                                        <NumberBox.Resources>
                                            <Style TargetType="TextBox">
                                                <Setter Property="TextAlignment" Value="Right" />
                                            </Style>
                                        </NumberBox.Resources>
                                    </NumberBox>

                                    <!-- Input Kredit -->
                                    <NumberBox
                                        Grid.Column="3"
                                        HorizontalAlignment="Stretch"
                                        FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                        IsEnabled="{Binding IsEditable, ElementName=RootControl}"
                                        Minimum="0"
                                        SpinButtonPlacementMode="Hidden"
                                        Value="{x:Bind CreditValue, Mode=TwoWay}"
                                        ValueChanged="CreditNumberBox_ValueChanged">
                                        <NumberBox.Resources>
                                            <Style TargetType="TextBox">
                                                <Setter Property="TextAlignment" Value="Right" />
                                            </Style>
                                        </NumberBox.Resources>
                                    </NumberBox>

                                    <!-- Tombol Hapus Baris -->
                                    <Button
                                        Grid.Column="4"
                                        Width="32"
                                        Height="32"
                                        Padding="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="RemoveLineButton_Click"
                                        ToolTipService.ToolTip="Hapus baris"
                                        Visibility="{Binding IsEditable, ElementName=RootControl}">
                                        <FontIcon
                                            FontSize="14"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            Glyph="&#xE74D;" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </Border>

        <!-- Tombol Tambah Baris -->
        <StackPanel
            HorizontalAlignment="Left"
            Orientation="Horizontal"
            Visibility="{x:Bind IsEditable, Mode=OneWay}">
            <Button Click="AddLineButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="12" Glyph="&#xE710;" />
                    <TextBlock Text="Tambah Baris" />
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
