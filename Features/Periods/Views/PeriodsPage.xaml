<Page
    x:Class="AumoDekstop.Features.Periods.Views.PeriodsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:AumoDekstop.Features.Periods.Views"
    Loaded="Page_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32"
                    Spacing="24"
                    MaxWidth="1400">
            <!-- Header Halaman -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Spacing="4">
                    <TextBlock
                        Text="Periode Buku Kas"
                        Style="{ThemeResource TitleTextBlockStyle}"/>
                    <TextBlock
                        Text="Kelola pembukaan dan penutupan periode pembukuan kas."
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Tombol Trigger Dialog Buka Periode Baru -->
                <Button
                    Grid.Column="1"
                    Style="{ThemeResource AccentButtonStyle}"
                    VerticalAlignment="Center"
                    IsEnabled="{x:Bind IsNotCreating, Mode=OneWay}"
                    Click="OpenNewPeriodButton_Click">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <FontIcon Glyph="&#xE710;"
                                  FontSize="14"/>
                        <TextBlock Text="Buka Periode Baru"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Alert Ringkasan Status -->
            <views:PeriodsAlertsControl
                HasActivePeriod="{x:Bind ViewModel.HasActivePeriod, Mode=OneWay}"
                ActivePeriodName="{x:Bind ActivePeriodName, Mode=OneWay}"
                WarningMessage="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"/>

            <!-- Tabel Data Periode -->
            <views:PeriodsTableControl
                Periods="{x:Bind ViewModel.Periods, Mode=OneWay}"
                IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                ClosePeriodRequested="PeriodsTable_ClosePeriodRequested"
                SelectPeriodRequested="PeriodsTable_SelectPeriodRequested"/>
        </StackPanel>
    </ScrollViewer>
</Page>
