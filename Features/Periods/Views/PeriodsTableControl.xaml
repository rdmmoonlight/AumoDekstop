<UserControl
    x:Class="AumoDekstop.Features.Periods.Views.PeriodsTableControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AumoDekstop.Features.Periods.Models">

    <Border
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Table Header -->
            <Border
                Grid.Row="0"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12"
                CornerRadius="8,8,0,0">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="64" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="Nama Periode"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        Grid.Column="1"
                        Text="Tanggal Mulai"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        Grid.Column="2"
                        Text="Tanggal Selesai"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        Grid.Column="3"
                        Text="Status"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock
                        Grid.Column="4"
                        Text="Aksi"
                        HorizontalAlignment="Right"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Border>

            <!-- State 1: Loading -->
            <StackPanel
                Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8"
                Height="96"
                Visibility="{x:Bind ShowLoadingState, Mode=OneWay}">
                <ProgressRing IsActive="{x:Bind IsLoading, Mode=OneWay}" Width="18" Height="18" />
                <TextBlock
                    Text="Memuat data periode..."
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- State 2: Empty Data -->
            <TextBlock
                Grid.Row="1"
                Text="Belum ada data periode."
                Height="96"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Padding="0,38,0,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Visibility="{x:Bind ShowEmptyState, Mode=OneWay}" />

            <!-- State 3: Table Rows -->
            <ListView
                Grid.Row="1"
                ItemsSource="{x:Bind Periods, Mode=OneWay}"
                SelectionMode="None"
                IsItemClickEnabled="False"
                Visibility="{x:Bind ShowListState, Mode=OneWay}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinHeight" Value="48" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:PeriodItem">
                        <Border
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>

                                <!-- Nama Periode -->
                                <TextBlock
                                    Grid.Column="0"
                                    Text="{x:Bind PeriodName}"
                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                    VerticalAlignment="Center"
                                    TextTrimming="CharacterEllipsis" />

                                <!-- Tanggal Mulai -->
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind FormattedStartDate}"
                                    VerticalAlignment="Center" />

                                <!-- Tanggal Selesai -->
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{x:Bind FormattedEndDate}"
                                    VerticalAlignment="Center" />

                                <!-- Status Badges -->
                                <StackPanel
                                    Grid.Column="3"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                                    <!-- Badge Terbuka -->
                                    <Border
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="4"
                                        Padding="8,2"
                                        Visibility="{x:Bind IsOpen, Mode=OneWay}">
                                        <TextBlock
                                            Text="Terbuka"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>

                                    <!-- Badge Tutup -->
                                    <Border
                                        Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                                        CornerRadius="4"
                                        Padding="8,2"
                                        Visibility="{x:Bind IsClosed, Mode=OneWay}">
                                        <TextBlock
                                            Text="Tutup"
                                            Style="{ThemeResource CaptionTextBlockStyle}"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>

                                    <!-- Badge Dipilih -->
                                    <Border
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8,2"
                                        Visibility="{x:Bind IsSelected, Mode=OneWay}">
                                        <TextBlock
                                            Text="Dipilih"
                                            Style="{ThemeResource CaptionTextBlockStyle}" />
                                    </Border>
                                </StackPanel>

                                <!-- DropdownMenu Aksi -->
                                <Button
                                    Grid.Column="4"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ToolTipService.ToolTip="Buka menu">
                                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuFlyoutItem
                                                Text="Tutup Periode"
                                                Tag="{x:Bind Id}"
                                                Visibility="{x:Bind IsOpen, Mode=OneWay}"
                                                Click="ClosePeriodMenuItem_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE72E;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>

                                            <MenuFlyoutItem
                                                Text="Pilih Periode"
                                                Tag="{x:Bind Id}"
                                                Visibility="{x:Bind CanSelect, Mode=OneWay}"
                                                Click="SelectPeriodMenuItem_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE73E;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Border>
</UserControl>
