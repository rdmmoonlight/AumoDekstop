<UserControl
    x:Class="AumoDekstop.Shell.Ribbon.RibbonPeriodsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AumoDekstop.Shell.Ribbon">

    <StackPanel Orientation="Horizontal">
        <Grid Padding="4,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <local:RibbonButton Glyph="&#xE787;" Label="Buka Periode" CommandId="new" Click="OnButtonClick" />
                <local:RibbonButton Glyph="&#xE72C;" Label="Muat Ulang" CommandId="periods.refresh" Click="OnButtonClick" />
            </StackPanel>
            <TextBlock Grid.Row="1" Text="Periode" FontSize="11" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </StackPanel>
</UserControl>
