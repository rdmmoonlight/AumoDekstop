<UserControl
    x:Class="AumoDekstop.Shell.Ribbon.RibbonSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AumoDekstop.Shell.Ribbon">

    <StackPanel Orientation="Horizontal">
        <Grid Padding="4,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <local:RibbonButton Glyph="&#xE7E8;" Label="Keluar" CommandId="logout" Click="OnButtonClick" />
            </StackPanel>
            <TextBlock Grid.Row="1" Text="Akun" FontSize="11" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <Rectangle Width="1" Height="64" Margin="4,0" VerticalAlignment="Center"
                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <Grid Padding="4,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <local:RibbonButton Glyph="&#xE895;" Label="Cek Update" CommandId="checkupdate" Click="OnButtonClick" />
                <local:RibbonButton Glyph="&#xE713;" Label="Preferensi" CommandId="comingsoon" Click="OnButtonClick" />
            </StackPanel>
            <TextBlock Grid.Row="1" Text="Aplikasi" FontSize="11" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </StackPanel>
</UserControl>
