<UserControl
    x:Class="AumoDekstop.Shell.Ribbon.RibbonReportsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AumoDekstop.Shell.Ribbon">

    <StackPanel Orientation="Horizontal">
        <!-- Grup 1: Neraca Saldo (Trial Balances) -->
        <Grid Padding="4,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <local:RibbonButton Glyph="&#xEA37;" Label="TB Awal" CommandId="UnadjustedTrialBalance" Click="OnButtonClick" />
                <local:RibbonButton Glyph="&#xE762;" Label="TB Penyesuaian" CommandId="AdjustedTrialBalance" Click="OnButtonClick" />
                <local:RibbonButton Glyph="&#xEA18;" Label="TB Penutup" CommandId="PostClosingTrialBalance" Click="OnButtonClick" />
            </StackPanel>
            <TextBlock Grid.Row="1" Text="Neraca Saldo" FontSize="11" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <Rectangle Width="1" Height="64" Margin="4,0" VerticalAlignment="Center"
                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- Grup 2: Kertas Kerja (Worksheet) -->
        <Grid Padding="4,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <local:RibbonButton Glyph="&#xE80A;" Label="Worksheet" CommandId="Worksheet" Click="OnButtonClick" />
            </StackPanel>
            <TextBlock Grid.Row="1" Text="Kertas Kerja" FontSize="11" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <Rectangle Width="1" Height="64" Margin="4,0" VerticalAlignment="Center"
                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- Grup 3: Laporan Keuangan (Financial Statements) -->
        <Grid Padding="4,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <local:RibbonButton Glyph="&#xE9D2;" Label="Laba Rugi" CommandId="IncomeStatement" Click="OnButtonClick" />
                <local:RibbonButton Glyph="&#xE8C7;" Label="Laba Ditahan" CommandId="RetainedEarnings" Click="OnButtonClick" />
                <local:RibbonButton Glyph="&#xE8AB;" Label="Arus Kas" CommandId="CashFlow" Click="OnButtonClick" />
                <local:RibbonButton Glyph="&#xE8A5;" Label="Neraca" CommandId="FinancialPosition" Click="OnButtonClick" />
            </StackPanel>
            <TextBlock Grid.Row="1" Text="Laporan Keuangan" FontSize="11" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <Rectangle Width="1" Height="64" Margin="4,0" VerticalAlignment="Center"
                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- Grup 4: Keluaran -->
        <Grid Padding="4,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <local:RibbonButton Glyph="&#xE749;" Label="Cetak" CommandId="comingsoon" Click="OnButtonClick" />
                <local:RibbonButton Glyph="&#xE896;" Label="Ekspor" CommandId="comingsoon" Click="OnButtonClick" />
            </StackPanel>
            <TextBlock Grid.Row="1" Text="Keluaran" FontSize="11" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </StackPanel>
</UserControl>
