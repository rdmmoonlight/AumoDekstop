<UserControl
    x:Class="AumoDekstop.Shell.Ribbon.RibbonHomePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AumoDekstop.Shell.Ribbon">

    <StackPanel Orientation="Horizontal">
        <Grid Padding="4,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <local:RibbonButton Glyph="&#xE710;" Label="Baru" CommandId="new" Click="OnButtonClick" />
                <local:RibbonButton Glyph="&#xE74E;" Label="Simpan" CommandId="save" Click="OnButtonClick" />
            </StackPanel>
            <TextBlock Grid.Row="1" Text="Berkas" FontSize="11" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <Rectangle Width="1" Height="64" Margin="4,0" VerticalAlignment="Center"
                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <Grid Padding="4,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <local:RibbonButton Glyph="&#xE72C;" Label="Sinkron API" CommandId="sync" Click="OnButtonClick" />
            </StackPanel>
            <TextBlock Grid.Row="1" Text="Server" FontSize="11" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <Rectangle Width="1" Height="64" Margin="4,0" VerticalAlignment="Center"
                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <Grid Padding="4,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <local:RibbonButton Glyph="&#xE895;" Label="Cek Update" CommandId="checkupdate" Click="OnButtonClick" />
            </StackPanel>
            <TextBlock Grid.Row="1" Text="Aplikasi" FontSize="11" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </StackPanel>
</UserControl>
